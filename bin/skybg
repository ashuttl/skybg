#!/usr/bin/env python3
"""skybg — sky-gradient backgrounds that track the sun, the weather, and the current Omarchy theme.

Samples the current theme's colors.toml, the sun's position (elevation AND
azimuth; location via `linecast location`), and current cloud cover / fog
(Open-Meteo) to render a sky gradient, in the spirit of linecast sunshine.
Theme-independent: switch themes and the sky re-tints.

- A soft glow tracks the sun across the screen (east-left in the morning,
  west-right in the afternoon), strongest around sunrise/sunset.
- Cloud cover grays and flattens the sky; fog all the more so.
- On clear nights the real sky comes out: the Yale Bright Star Catalogue and
  the Milky Way, projected for the place and the hour, rising in the east
  and setting in the west as sidereal time advances.

A second style, "daylight", is a port of Pond's Daylight wallpaper: a quiet
six-band gradient from a fixed palette, paced by the day's real sunrise and
sunset. It ignores the theme and the weather.

A third, "bokashi", is a woodblock-print sky: a band of ink wiped down from
the top edge, a flat ground, a band of colour at the horizon, a flat red sun
where the sun is, and the moon in its phase, in inks tinted by the theme.

A fourth, "cyanotype", charts the sky instead of painting it: white on
Prussian blue, the sun's path for today as a wave over and under a ruled
horizon, with the solstice and equinox paths behind it; the blue is the
theme's.

Three more: "gradient" is a plain gradient that turns with the sun like the
shadow on a sundial, lit from wherever the sun is; "window" is the sun
through a window, its panes thrown into a bare room, across the far wall and
the floor, softened and put out by cloud, with the moon's at night; "slitscan" is the whole day at once, each
column of the screen the sky at a different hour, with now in the middle.
Choose with `skybg config style`.

Commands:
  skybg on             generate + set the background, and start the 5-minute timer
  skybg off            stop the timer (background stays until you change it)
  skybg once           generate + set once, without touching the timer
  skybg tick           timer entry point: refresh if skybg still owns the background;
                       after two ticks of a foreign background, stop the timer
  skybg status         show location, sun position, weather, phase, timer state
  skybg doctor         check dependencies, location, theme, and installed units
  skybg preview [N]    render a 24-hour montage to ~/Pictures/skybg-day-preview.png,
                       at N% cloud cover (default: live weather)
  skybg config ...     set location, weather behavior, and style
"""

import datetime
import argparse
import contextlib
import fcntl
import gzip
import itertools
import json
import math
import os
import plistlib
import re
import shutil
import struct
import subprocess
import sys
import time
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
IS_MAC = sys.platform == "darwin"
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "skybg")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
USER_COLORS_TOML = os.path.join(CONFIG_DIR, "colors.toml")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "skybg")
COLORS_TOML = os.path.join(HOME, ".local/state/omarchy/current/theme/colors.toml")
BACKGROUND_LINK = os.path.join(HOME, ".local/state/omarchy/current/background")
LAUNCH_AGENT_LABEL = "com.skybg.tick"
LAUNCH_AGENT_PLIST = os.path.join(HOME, "Library/LaunchAgents", LAUNCH_AGENT_LABEL + ".plist")
WALLPAPER_STORE = os.path.join(HOME, "Library/Application Support/com.apple.wallpaper/Store/Index.plist")
RENDER_NAME = re.compile(r"sky-[^.]+\.png")
LOCATION_CACHE = os.path.join(STATE_DIR, "location")
WEATHER_CACHE = os.path.join(STATE_DIR, "weather.json")
FOREIGN_MARKER = os.path.join(STATE_DIR, "foreign-seen")
WEATHER_TTL = 1200  # seconds
FOG_CODES = {45, 48}
STYLES = ("sky", "daylight", "bokashi", "cyanotype", "gradient", "window", "slitscan")
WEATHER_STYLES = ("sky", "window")


class SkybgError(Exception):
    """An expected, actionable skybg failure."""


def load_config():
    try:
        with open(CONFIG_FILE) as f:
            data = json.load(f)
    except FileNotFoundError:
        return {"location": "auto", "weather": True, "style": "sky"}
    except (OSError, ValueError) as exc:
        raise SkybgError(f"could not read {CONFIG_FILE}: {exc}") from exc
    data.setdefault("location", "auto")
    data.setdefault("weather", True)
    data.setdefault("style", "sky")
    if data["style"] not in STYLES:
        raise SkybgError(f"unknown style {data['style']!r} in {CONFIG_FILE}; "
                         f"run 'skybg config style {'|'.join(STYLES)}'")
    return data


def save_config(config):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    temporary = CONFIG_FILE + ".tmp"
    with open(temporary, "w") as f:
        json.dump(config, f, indent=2)
        f.write("\n")
    os.replace(temporary, CONFIG_FILE)


def current_style():
    return load_config().get("style", "sky")


@contextlib.contextmanager
def render_lock():
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(os.path.join(STATE_DIR, "render.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def which(name):
    # launchd and systemd timers run with a minimal PATH; look in the usual
    # install prefixes too.
    extra = os.pathsep.join([os.path.join(HOME, ".local/bin"), "/usr/bin", "/usr/local/bin",
                             "/opt/homebrew/bin"])
    return shutil.which(name, path=os.environ.get("PATH", "") + os.pathsep + extra) or name


def clamp(v, lo=0.0, hi=1.0):
    return max(lo, min(hi, v))


def smoothstep(lo, hi, v):
    t = clamp((v - lo) / (hi - lo))
    return t * t * (3 - 2 * t)


# ---------- location ----------

def get_location():
    configured = load_config()["location"]
    if configured != "auto":
        try:
            lat, lon = map(float, configured)
            if not (-90 <= lat <= 90 and -180 <= lon <= 180):
                raise ValueError
            return lat, lon
        except (TypeError, ValueError):
            raise SkybgError(f"invalid location in {CONFIG_FILE}; run 'skybg config location auto'")
    try:
        out = subprocess.run(
            [which("linecast"), "location"],
            capture_output=True, text=True, timeout=15,
        ).stdout
        m = re.search(r"\((-?\d+\.?\d*),\s*(-?\d+\.?\d*)\)", out)
        if m:
            lat, lon = float(m.group(1)), float(m.group(2))
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(LOCATION_CACHE, "w") as f:
                f.write(f"{lat} {lon}\n")
            return lat, lon
    except Exception:
        pass
    try:
        with open(LOCATION_CACHE) as f:
            lat, lon = f.read().split()
            return float(lat), float(lon)
    except Exception:
        raise SkybgError(
            "no location available; install/configure linecast or run "
            "'skybg config location LAT LON'"
        )


# ---------- weather ----------

def uses_weather():
    return load_config()["weather"] and current_style() in WEATHER_STYLES


def get_weather(lat, lon):
    """Returns (cloud_fraction 0..1, is_fog). Cached; degrades to last-known, then 0.3."""
    if not uses_weather():
        return 0.0, False
    try:
        with open(WEATHER_CACHE) as f:
            cached = json.load(f)
        # A cache from a different location is useless, even as a last-known
        # fallback (0.05° ≈ 5 km, comfortably inside forecast granularity).
        if abs(cached["lat"] - lat) > 0.05 or abs(cached["lon"] - lon) > 0.05:
            cached = None
        elif time.time() - cached["ts"] < WEATHER_TTL:
            return cached["cloud"], cached["fog"]
    except Exception:
        cached = None

    url = (f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}"
           "&current=cloud_cover,weather_code")
    try:
        with urllib.request.urlopen(url, timeout=15) as resp:
            current = json.load(resp)["current"]
        cloud = clamp(current["cloud_cover"] / 100)
        fog = current["weather_code"] in FOG_CODES
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(WEATHER_CACHE, "w") as f:
            json.dump({"ts": time.time(), "cloud": cloud, "fog": fog,
                       "lat": lat, "lon": lon}, f)
        return cloud, fog
    except Exception:
        if cached:
            return cached["cloud"], cached["fog"]
        return 0.3, False


# ---------- sun ----------

def solar_position(lat, lon, t_utc):
    """(elevation, azimuth-from-north) in degrees. NOAA approximation."""
    frac_hour = t_utc.hour + t_utc.minute / 60 + t_utc.second / 3600
    gamma = 2 * math.pi / 365 * (t_utc.timetuple().tm_yday - 1 + (frac_hour - 12) / 24)
    decl = (0.006918 - 0.399912 * math.cos(gamma) + 0.070257 * math.sin(gamma)
            - 0.006758 * math.cos(2 * gamma) + 0.000907 * math.sin(2 * gamma)
            - 0.002697 * math.cos(3 * gamma) + 0.00148 * math.sin(3 * gamma))
    eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(gamma) - 0.032077 * math.sin(gamma)
                       - 0.014615 * math.cos(2 * gamma) - 0.040849 * math.sin(2 * gamma))
    ha = math.radians((frac_hour * 60 + eqtime + 4 * lon) / 4 - 180)
    lat_r = math.radians(lat)
    cos_zen = (math.sin(lat_r) * math.sin(decl)
               + math.cos(lat_r) * math.cos(decl) * math.cos(ha))
    elev = math.degrees(math.asin(clamp(cos_zen, -1.0, 1.0)))
    az = math.degrees(math.atan2(
        math.sin(ha),
        math.cos(ha) * math.sin(lat_r) - math.tan(decl) * math.cos(lat_r)))
    return elev, (az + 180) % 360


PHASES = [(-90, "night"), (-12, "astronomical twilight"), (-6, "nautical twilight"),
          (-4, "civil twilight"), (0.5, "golden hour"), (8, "day")]


def phase_name(elev):
    name = PHASES[0][1]
    for threshold, n in PHASES:
        if elev >= threshold:
            name = n
    return name


# ---------- colors ----------

def hexrgb(s):
    s = s.lstrip("#")
    return tuple(int(s[i:i + 2], 16) / 255 for i in (0, 2, 4))


def lerp(a, b, t):
    return tuple(a[i] + (b[i] - a[i]) * t for i in range(3))


def lighten(c, t):
    return lerp(c, (1.0, 1.0, 1.0), t)


def gray_of(c):
    y = 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]
    return (y, y, y)


ANSI_SLOTS = {"red": 1, "green": 2, "yellow": 3, "blue": 4, "magenta": 5, "cyan": 6}
HUE_DEFAULTS = {"red": "#b05f58", "green": "#6f9a76", "yellow": "#c4a76a",
                "blue": "#6d8fb4", "cyan": "#6fa7a0", "magenta": "#9a7fa8"}


# With no theme to match, aim for a realistic sky rather than a neutral one:
# saturated hue anchors, and a dusk-blue background even for the light
# appearance (the background is the night sky, and every daytime stop mixes
# from it, so a near-gray background washes out the whole cycle).
BASE_DEFAULTS = {
    "dark": {"background": "#1c2536", "foreground": "#dce4f0", "bright_foreground": "#c8d4f0",
             "blue": "#3a80d8", "cyan": "#86c8e8", "magenta": "#a96bb4",
             "red": "#d95c48", "yellow": "#f0bd62", "orange": "#e08a52"},
    "light": {"background": "#3a4a68", "foreground": "#eef3fa", "bright_foreground": "#d4e0f6",
              "blue": "#4a90e0", "cyan": "#8fd8f0", "magenta": "#c078b8",
              "red": "#e86a50", "yellow": "#f8d078", "orange": "#f09055"},
}


def macos_dark_mode():
    out = subprocess.run(["defaults", "read", "-g", "AppleInterfaceStyle"],
                         capture_output=True, text=True, timeout=10).stdout
    return out.strip() == "Dark"


def theme_source():
    """(kind, detail) describing where colors come from: an Omarchy theme, a
    user colors.toml, or (macOS only) built-in defaults per appearance."""
    if os.path.isfile(COLORS_TOML):
        return "omarchy", COLORS_TOML
    if os.path.isfile(USER_COLORS_TOML):
        return "file", USER_COLORS_TOML
    if IS_MAC:
        return "builtin", "dark" if macos_dark_mode() else "light"
    return None, None


def theme_colors():
    """Parse the current theme's colors.toml, normalized so every key skybg
    uses exists — older/minimal themes may only define color0-15 ANSI slots.
    On macOS without a colors.toml, fall back to a built-in palette matched
    to the system light/dark appearance."""
    kind, detail = theme_source()
    if kind is None:
        raise SkybgError("no active Omarchy theme found")
    if kind == "builtin":
        raw = dict(BASE_DEFAULTS[detail])
    else:
        import tomllib
        with open(detail, "rb") as f:
            raw = tomllib.load(f)
    c = {k: hexrgb(v) for k, v in raw.items() if isinstance(v, str) and v.startswith("#")}

    c.setdefault("background", hexrgb("#20242b"))
    c.setdefault("foreground", hexrgb("#d0d5da"))
    for name, slot in ANSI_SLOTS.items():
        if name not in c and f"color{slot}" in c:
            c[name] = c[f"color{slot}"]
        if f"bright_{name}" not in c:
            if f"color{slot + 8}" in c:
                c[f"bright_{name}"] = c[f"color{slot + 8}"]
            elif name in c:
                c[f"bright_{name}"] = lighten(c[name], 0.2)
    for name, fallback in HUE_DEFAULTS.items():
        c.setdefault(name, hexrgb(fallback))
    c.setdefault("orange", lerp(c["red"], c["yellow"], 0.5))
    c.setdefault("dark_background", lerp(c["background"], (0, 0, 0), 0.2))
    c.setdefault("darker_background", lerp(c["background"], (0, 0, 0), 0.35))
    c.setdefault("lighter_background", lighten(c["background"], 0.10))
    c.setdefault("bright_foreground", lighten(c["foreground"], 0.2))
    return c


# How bright the day sky gets. At 1.0 it is linecast's sky, mixed from the
# theme's hues toward its bright foreground; lower mixes the day back toward
# the theme background, which suits a wallpaper behind dark windows.
DAY_BRIGHTNESS = 0.7


def sky_stops(elev, c):
    """(zenith, far, near) colors for a sun elevation, blended from theme
    colors: the sky overhead, the horizon opposite the sun, and the horizon
    under it.

    The shape follows linecast's sky view. Through twilight the sunward
    horizon runs magenta, red, then orange while the far side holds the
    mauve of the Earth's shadow; by day the horizon is paler than the
    zenith, not darker, as the air whitens it."""
    bg = c["background"]
    dbg = c.get("darker_background", bg)
    lbg = c.get("lighter_background", bg)
    blue, cyan = c["blue"], c["cyan"]
    mag, orange, red, yellow = c["magenta"], c["orange"], c["red"], c["yellow"]

    # By day the sky mixes from the theme's hues toward its bright
    # foreground, as linecast's sky does toward white: a day sky that mixed
    # from a dark theme's background stayed a dusk. Toward the sun the
    # horizon leans to the theme's cyan, but only part way: a teal cyan
    # beside a blue sky reads as green.
    # A touch of the sky's own blue keeps a near-white foreground from
    # bleaching the noon sky.
    white = lerp(c.get("bright_foreground", (0.9, 0.92, 0.95)), blue, 0.15)
    sky_cyan = lerp(blue, cyan, 0.6)
    cream = lerp(yellow, white, 0.5)

    def day(color):
        return lerp(bg, color, DAY_BRIGHTNESS)
    keyframes = [
        (-18, (dbg, bg, bg)),
        (-12, (lerp(dbg, blue, 0.06), lerp(bg, mag, 0.10), lerp(bg, mag, 0.18))),
        (-6, (lerp(dbg, blue, 0.12), lerp(bg, mag, 0.30),
              lerp(bg, lerp(red, mag, 0.5), 0.45))),
        (-3, (lerp(bg, mag, 0.20), lerp(bg, lerp(mag, red, 0.3), 0.45),
              lerp(bg, lerp(red, mag, 0.25), 0.70))),
        (0, (lerp(bg, lerp(mag, blue, 0.35), 0.45), lerp(bg, lerp(red, mag, 0.4), 0.55),
             lerp(bg, lerp(orange, yellow, 0.3), 0.85))),
        (3, (lerp(bg, lerp(mag, blue, 0.5), 0.65), lerp(bg, lerp(mag, cyan, 0.3), 0.65),
             lerp(lerp(yellow, orange, 0.3), white, 0.15))),
        (8, (day(lerp(blue, cyan, 0.20)), day(lerp(lerp(blue, cyan, 0.5), white, 0.30)),
             day(cream))),
        (15, (day(lerp(blue, cyan, 0.35)), day(lerp(blue, white, 0.52)),
              day(lerp(sky_cyan, white, 0.55)))),
        (30, (day(lerp(blue, white, 0.45)), day(lerp(blue, white, 0.70)),
              day(lerp(sky_cyan, white, 0.72)))),
        (90, (day(lerp(blue, white, 0.60)), day(lerp(blue, white, 0.80)),
              day(lerp(sky_cyan, white, 0.82)))),
    ]

    if elev <= keyframes[0][0]:
        return keyframes[0][1]
    if elev >= keyframes[-1][0]:
        return keyframes[-1][1]
    for (e0, s0), (e1, s1) in zip(keyframes, keyframes[1:]):
        if e0 <= elev <= e1:
            t = smoothstep(e0, e1, elev)
            return tuple(lerp(s0[i], s1[i], t) for i in range(3))


# ---------- sky field ----------

GRID_W, GRID_H = 64, 40
AZ_SPAN = 257.0   # degrees of azimuth across the screen, centred on south
ALT_TOP = 60.0    # altitude at the top edge; the bottom edge is the horizon


def sun_screen_x(az):
    """Where an azimuth falls across the screen: east left, west right."""
    return 0.5 + (az - 180) / AZ_SPAN


def sky_field(c, elev, az, cloud, fog):
    """Small 2D pixel grid: the sky by altitude and by bearing from the
    sun, a glow about the sun, and weather graying."""
    if fog:
        cloud = max(cloud, 0.85)
    zenith, far, near = sky_stops(elev, c)
    night = c.get("darker_background", c["background"])

    # Cloud hides the sunward glow and flattens the sky toward one tone.
    near = lerp(near, far, 0.7 * cloud)
    far = lerp(far, zenith, 0.35 * cloud)
    near = lerp(near, zenith, 0.35 * cloud)
    zenith = lerp(zenith, far, 0.15 * cloud)

    # Afternoon runs slightly warmer than morning.
    warm = 0.10 * smoothstep(180, 250, az) * smoothstep(4, 15, elev)
    if warm > 0:
        near = lerp(near, c["orange"], warm)

    # The horizon's colour reaches up the sky a little at night and in
    # twilight and a long way by day (an exponential in altitude, its scale
    # height in degrees); toward the zenith the twilight sky keeps some night.
    height = 18.0 + 30.0 * clamp(elev / 30)
    brightness = clamp((elev + 18) / 18)

    # Sun screen position: azimuth east->left, west->right; low sun sits low.
    sun_x = clamp(sun_screen_x(az), 0.06, 0.94)
    sun_y = 1.05 - 0.9 * clamp((elev + 6) / 66)
    sigma = 0.33 + 0.15 * clamp(elev / 60)
    glow_strength = (0.4 * math.exp(-((elev - 1) / 11) ** 2)
                     + 0.12 * smoothstep(10, 30, elev))
    glow_strength *= (1 - 0.85 * cloud)
    if elev < -7:
        glow_strength = 0.0
    glow_color = lerp(c["orange"], lighten(c["yellow"], 0.25), clamp(elev / 20))

    gray_w = 0.55 * cloud
    dim = 1 - 0.07 * cloud * smoothstep(0, 8, elev)

    # Each column's bearing from the sun: 1 under it, 0 opposite, bell-shaped
    # about it, so the warm side stays a band and the far side keeps its mauve.
    sun_az = math.radians(az)
    toward = []
    for gx in range(GRID_W):
        col_az = math.radians(180 + (gx / (GRID_W - 1) - 0.5) * AZ_SPAN)
        toward.append(((1 + math.cos(col_az - sun_az)) / 2) ** 4)

    pixels = []
    for gy in range(GRID_H):
        p = gy / (GRID_H - 1)
        alt = ALT_TOP * (1 - p)
        v = math.exp(-alt / height)
        keep = brightness + (1 - brightness) * v
        row = []
        for gx in range(GRID_W):
            x = gx / (GRID_W - 1)
            horizon = lerp(far, near, toward[gx])
            color = lerp(night, lerp(zenith, horizon, v), keep)
            if glow_strength > 0:
                d2 = ((x - sun_x) / (sigma * 1.7)) ** 2 + ((p - sun_y) / sigma) ** 2
                g = glow_strength * math.exp(-d2)
                if g > 0.003:
                    color = lerp(color, glow_color, clamp(g, 0, 0.55))
            if gray_w > 0:
                color = lerp(color, gray_of(color), gray_w)
            row.append(tuple(v_ * dim for v_ in color))
        pixels.append(row)
    return pixels


def star_visibility(elev, cloud):
    """How strongly stars should show through twilight and cloud."""
    return clamp((-elev - 4) / 5) * clamp((0.65 - cloud) / 0.5)


def milky_way_visibility(elev, cloud):
    """The Milky Way waits for astronomical dark, and thin cloud takes it
    before it takes the stars."""
    return clamp((-elev - 12) / 6) * clamp((0.65 - cloud) / 0.5) ** 1.5


def local_sidereal_angle(t_utc, lon):
    """Local mean sidereal angle in radians (sufficient for a background)."""
    unix_days = t_utc.timestamp() / 86400
    julian_date = 2440587.5 + unix_days
    days_since_j2000 = julian_date - 2451545.0
    gmst = 280.46061837 + 360.98564736629 * days_since_j2000
    return math.radians((gmst + lon) % 360)


# ---------- the sky's data ----------
# The stars are the Yale Bright Star Catalogue to magnitude 6.5; the Milky
# Way is NASA's Deep Star Maps 2020 diffuse layer as a brightness raster in
# celestial coordinates. Both are baked by scripts/build-sky-data.py and
# described in data/SOURCES.md.

MILKY_WAY_W, MILKY_WAY_H = 1080, 540
_sky_data = {}


def data_dir():
    """The first directory that holds the sky data: $SKYBG_DATA, the
    checkout's data/ beside this script, or the installed copy."""
    candidates = [
        os.environ.get("SKYBG_DATA"),
        os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "data"),
        os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share")),
                     "skybg"),
    ]
    for candidate in candidates:
        if candidate and os.path.isfile(os.path.join(candidate, "stars.bin")):
            return os.path.normpath(candidate)
    raise SkybgError("sky data (stars.bin, milkyway.bin.gz) not found; run ./install.sh "
                     "or set SKYBG_DATA to the checkout's data directory")


def load_stars():
    """The catalogue as (x, y, z, magnitude, B-V) with the unit vector in
    equatorial coordinates, brightest first."""
    if "stars" not in _sky_data:
        with open(os.path.join(data_dir(), "stars.bin"), "rb") as f:
            raw = f.read()
        stars = []
        for ra, dec, mag, bv in struct.iter_unpack("<Hhbb", raw):
            ra_r, dec_r = math.radians(ra / 100), math.radians(dec / 100)
            stars.append((math.cos(dec_r) * math.cos(ra_r), math.cos(dec_r) * math.sin(ra_r),
                          math.sin(dec_r), mag / 10, bv / 50))
        _sky_data["stars"] = stars
    return _sky_data["stars"]


def load_milky_way():
    """The Milky Way's brightness, 0-255, row-major; right ascension 0h in
    the middle column increasing leftward, declination +90 at the top."""
    if "milky_way" not in _sky_data:
        with gzip.open(os.path.join(data_dir(), "milkyway.bin.gz"), "rb") as f:
            raster = f.read()
        if len(raster) != MILKY_WAY_W * MILKY_WAY_H:
            raise SkybgError("milkyway.bin.gz is not a %dx%d raster" % (MILKY_WAY_W, MILKY_WAY_H))
        _sky_data["milky_way"] = raster
    return _sky_data["milky_way"]


# ---------- the camera ----------
# The observer faces south (north in the southern hemisphere) and looks up
# enough that the horizon runs along the bottom edge of the screen. The
# projection is stereographic, so the Milky Way keeps its shape from the
# horizon to near the zenith, and stars rise on the left and set on the
# right as sidereal time advances.

FOV = 110.0   # degrees of sky across the width of the screen


def camera(width, height, lat, t_utc, lon):
    """The matrix that takes an equatorial unit vector to camera space
    (x right, y up, z forward), its transpose, the focal length, and the
    matrix to the local horizontal frame (east, north, up)."""
    f = width / (4 * math.tan(math.radians(FOV) / 4))
    # Looking up until the horizon meets the bottom edge, but never past
    # the point where the zenith reaches the top: a tall frame keeps some
    # of the ground instead.
    pitch = min(math.pi / 4, 2 * math.atan(height / (4 * f)))
    theta, phi = local_sidereal_angle(t_utc, lon), math.radians(lat)
    st, ct, sp, cp = math.sin(theta), math.cos(theta), math.sin(phi), math.cos(phi)
    horizontal = ((-st, ct, 0.0),
                  (-sp * ct, -sp * st, cp),
                  (cp * ct, cp * st, sp))
    facing = -1.0 if lat >= 0 else 1.0   # forward's north component's sign
    s, c = math.sin(pitch), math.cos(pitch)
    right = (facing, 0.0, 0.0)           # west is on the right when facing south
    up = (0.0, -facing * s, c)
    forward = (0.0, facing * c, s)
    cam = tuple(tuple(sum(row[k] * horizontal[k][j] for k in range(3)) for j in range(3))
                for row in (right, up, forward))
    inverse = tuple(tuple(cam[j][i] for j in range(3)) for i in range(3))
    return cam, inverse, f, horizontal


def project(c, f, cx, cy):
    """Screen position of a camera-space unit vector, or None behind."""
    x, y, z = c
    if z < 0.05:
        return None
    return cx + 2 * f * x / (1 + z), cy - 2 * f * y / (1 + z)


def unproject(px, py, f, cx, cy):
    """Camera-space unit vector through a screen position."""
    u, v = (px - cx) / (2 * f), (cy - py) / (2 * f)
    rho2 = u * u + v * v
    d = 1 + rho2
    return 2 * u / d, 2 * v / d, (1 - rho2) / d


def altitude_of(q, horizontal):
    """Altitude in degrees of an equatorial unit vector."""
    row = horizontal[2]
    return math.degrees(math.asin(clamp(row[0] * q[0] + row[1] * q[1] + row[2] * q[2], -1, 1)))


# ---------- stars and the Milky Way ----------

def star_tint(base, bv):
    """The catalogue's B-V colour as a gentle cast on the theme's star colour:
    blue-white for the hot stars, warm for the giants."""
    blue = clamp((0.3 - bv) / 0.6) * 0.45
    warm = clamp((bv - 0.8) / 0.8) * 0.5
    color = lerp(base, (0.72, 0.82, 1.0), blue)
    return lerp(color, (1.0, 0.86, 0.66), warm)


def star_mvg(width, height, elev, cloud, c, t_utc, lat, lon):
    """MVG commands drawing the catalogue stars above the horizon.

    Brightness follows magnitude: the faint stars are single points, the
    bright ones small discs with a soft halo. The horizon takes the low
    ones, as the air does.
    """
    visibility = star_visibility(elev, cloud)
    if visibility <= 0:
        return None
    base = lighten(c.get("bright_foreground", (0.9, 0.92, 0.94)), 0.3)
    cam, _, f, horizontal = camera(width, height, lat, t_utc, lon)
    cx, cy = width / 2, height / 2
    scale = width / 2560
    # A small render (a preview panel) keeps only the brighter stars, so
    # the sky stays a sky and not a grain.
    limit = 6.5 - 2.5 * clamp((1600 - width) / 1400)
    lines = []
    for qx, qy, qz, mag, bv in load_stars():
        if mag > limit:
            break
        q = (qx, qy, qz)
        at = project(tuple(row[0] * qx + row[1] * qy + row[2] * qz for row in cam), f, cx, cy)
        if at is None:
            continue
        x, y = at
        if not (-2 <= x <= width + 2 and -2 <= y <= height + 2):
            continue
        alt = altitude_of(q, horizontal)
        if alt <= 0:
            continue
        t = clamp((6.5 - mag) / 8)
        alpha = (0.30 + 0.70 * t ** 1.2) * visibility * smoothstep(0, 10, alt)
        if alpha < 0.02:
            continue
        r, g, b = (round(v * 255) for v in star_tint(base, bv))
        radius = max(0.45, (0.6 + 2.6 * t) * scale)
        # The bright ones glow: a stack of wider, fainter discs.
        if t > 0.45:
            for spread, share in ((3.0, 0.06), (2.0, 0.12), (1.4, 0.3)):
                lines.append(f"fill rgba({r},{g},{b},{alpha * share:.3f})")
                lines.append(f"circle {x:.1f},{y:.1f} {x + radius * spread:.1f},{y:.1f}")
        lines.append(f"fill rgba({r},{g},{b},{alpha:.3f})")
        lines.append(f"circle {x:.1f},{y:.1f} {x + radius:.1f},{y:.1f}")
    return "\n".join(lines)


MILKY_WAY_STRENGTH = 0.30   # the brightest of the band as light added over the sky
MILKY_WAY_SCALE = 6         # the layer is rendered at this fraction of the screen


def milky_way_ppm(width, height, elev, cloud, c, t_utc, lat, lon):
    """A small RGB layer of the Milky Way to screen over the sky, or None
    when it would not show. Each pixel looks along the camera into the
    raster; the band thins toward the horizon and fades with twilight and
    cloud faster than the stars do."""
    visibility = milky_way_visibility(elev, cloud)
    if visibility <= 0:
        return None
    raster = load_milky_way()
    base = lighten(c.get("bright_foreground", (0.9, 0.92, 0.94)), 0.3)
    milky = lerp(base, (0.78, 0.84, 1.0), 0.25)
    gw, gh = max(16, width // MILKY_WAY_SCALE), max(10, height // MILKY_WAY_SCALE)
    cam, inverse, f, horizontal = camera(width, height, lat, t_utc, lon)
    cx, cy = width / 2, height / 2
    step = width / gw
    up_row = horizontal[2]
    mw_w, mw_h = MILKY_WAY_W, MILKY_WAY_H
    strength = MILKY_WAY_STRENGTH * visibility
    out = bytearray()
    for gy in range(gh):
        py = (gy + 0.5) * step
        for gx in range(gw):
            x, y, z = unproject((gx + 0.5) * step, py, f, cx, cy)
            q = tuple(row[0] * x + row[1] * y + row[2] * z for row in inverse)
            sin_alt = up_row[0] * q[0] + up_row[1] * q[1] + up_row[2] * q[2]
            if sin_alt <= 0:
                out += b"\0\0\0"
                continue
            ra = math.degrees(math.atan2(q[1], q[0]))
            dec = math.degrees(math.asin(clamp(q[2], -1, 1)))
            col = (mw_w / 2 - ra * mw_w / 360) % mw_w
            row = min(mw_h - 1.001, (90 - dec) * mw_h / 180)
            c0, r0 = int(col), int(row)
            fc, fr = col - c0, row - r0
            c1 = (c0 + 1) % mw_w
            top = raster[r0 * mw_w + c0] * (1 - fc) + raster[r0 * mw_w + c1] * fc
            bottom = raster[(r0 + 1) * mw_w + c0] * (1 - fc) + raster[(r0 + 1) * mw_w + c1] * fc
            level = (top * (1 - fr) + bottom * fr) / 255
            level *= strength * min(1.0, math.degrees(math.asin(sin_alt)) / 14)
            out += bytes(round(clamp(v * level) * 255) for v in milky)
    return f"P6\n{gw} {gh}\n255\n".encode() + bytes(out)


# ---------- rendering ----------

# ---------- daylight style ----------
#
# A port of the Daylight wallpaper from Pond (pond-wallpaper 0.2.0: SkyState.js
# and sky.frag). Copyright (c) 2026, Butterfly Interaction Inc. BSD-3-Clause;
# the full notice is in LICENSES/pond-wallpaper.txt. The palette, the
# interpolation and the tone curve are Pond's. What is skybg's: sunrise and
# sunset come from the sun at the configured location rather than a fixed
# 6:30 and 18:30, and the picture is rendered to a file instead of a shader.

DAYLIGHT = {"brightness": 0.65, "saturation": 0.70, "warmth": 0.012,
            "horizon": 0.84, "twilight": 1.95, "sunrise": 6.5, "sunset": 18.5}
DAYLIGHT_SUNRISE_LIMITS = (4.0, 9.0)
DAYLIGHT_SUNSET_LIMITS = (15.0, 22.0)
DAYLIGHT_MAX_CHROMA = 0.085
SUN_RISE_ELEVATION = -0.833   # the upper limb on the horizon, with refraction


def srgb_to_oklab(rgb):
    """Oklab (Björn Ottosson, public domain) from gamma-encoded sRGB."""
    r, g, b = (v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4 for v in rgb)
    l = math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
    m = math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
    s = math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def oklab_to_srgb(lab):
    """Gamma-encoded sRGB from Oklab; out-of-gamut colours leave 0..1."""
    L, a, b = lab
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    linear = (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
              -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
              -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)
    return tuple(12.92 * v if v < 0.0031308 else 1.055 * max(v, 0.0) ** (1 / 2.4) - 0.055
                 for v in linear)


# Each anchor is an hour of the palette's own day (sunrise 6.5, sunset 18.5)
# and six bands down the screen: zenith, upper sky, middle sky, haze, horizon,
# lower edge. A row is the six band positions, then the six colours in Oklab.
DAYLIGHT_ANCHORS = [
    (hour, positions + [v for color in colors for v in srgb_to_oklab(hexrgb(color))])
    for hour, positions, colors in [
        (0, [0, .33, .59, .78, .90, 1], ["080b16", "0d1220", "141d2d", "1c2939", "26313e", "1b2331"]),
        (3, [0, .40, .64, .80, .92, 1], ["090d1b", "111a2b", "21324a", "334958", "514c50", "262c3b"]),
        (4.8, [0, .355, .61, .79, .91, 1], ["172036", "2d3e56", "515c6d", "796d76", "a3797e", "504e62"]),
        (6.5, [0, .28, .515, .74, .905, 1], ["2e3b52", "4c596d", "76757f", "a6868f", "bf948a", "87717a"]),
        (8.5, [0, .25, .49, .73, .905, 1], ["405368", "5b6c7c", "7e888e", "a39b9b", "bca4a0", "a99193"]),
        (12, [0, .25, .52, .75, .93, 1], ["4d697b", "617d8b", "7a929c", "94a4a7", "b3b1bc", "aba8b2"]),
        (15, [0, .27, .52, .76, .93, 1], ["4e6575", "687d88", "879698", "aba3a8", "bdaba3", "ad9795"]),
        (17.3, [0, .25, .49, .73, .905, 1], ["405368", "5b6c7c", "7e888e", "a39b9b", "bca4a0", "a99193"]),
        (18.5, [0, .28, .515, .74, .905, 1], ["2e3b52", "4c596d", "76757f", "a6868f", "bf948a", "87717a"]),
        (19.6, [0, .355, .61, .79, .91, 1], ["172036", "2d3e56", "515c6d", "796d76", "a3797e", "504e62"]),
        (21, [0, .38, .63, .81, .93, 1], ["0f1529", "1c2942", "2e4059", "475369", "62586b", "2d334b"]),
        (23, [0, .35, .60, .80, .92, 1], ["090d1b", "10192a", "1b2b3f", "293b4e", "3d4655", "232d3e"]),
    ]
]
# The palette hours of: twilight's start, sunrise, full morning, the start of
# evening, sunset, twilight's end.
DAYLIGHT_PALETTE_TIMES = [4.8, 6.5, 8.5, 17.3, 18.5, 19.6]


def pchip_slope(d0, d1, h0, h1):
    """Shape-preserving tangent between two secants: no overshoot."""
    if d0 * d1 <= 0:
        return 0.0
    w1, w2 = 2 * h1 + h0, h1 + 2 * h0
    return (w1 + w2) / (w1 / d0 + w2 / d1)


def hermite(y0, y1, m0, m1, h, u):
    return ((2 * u ** 3 - 3 * u * u + 1) * y0 + (u ** 3 - 2 * u * u + u) * h * m0
            + (-2 * u ** 3 + 3 * u * u) * y1 + (u ** 3 - u * u) * h * m1)


def periodic_knots(xs, x):
    """The four knots around `x` on a 24-hour circle, as (index, hour) pairs
    whose hours run on past 0 and 24 where the circle wraps."""
    count = len(xs)
    following = next((k for k, value in enumerate(xs) if value > x), count)
    i = following - 1
    return [(k % count, xs[k % count] + (-24 if k < 0 else 24 if k >= count else 0))
            for k in (i - 1, i, i + 1, i + 2)]


def daylight_palette_hour(hour, sunrise, sunset, twilight=DAYLIGHT["twilight"]):
    """Map a clock hour onto the palette's day, so that its sunrise and sunset
    fall on the real ones, continuously through midnight."""
    twilight = min(twilight, (24 - sunset + sunrise) / 3)
    times = [sunrise - twilight, sunrise, sunrise + twilight,
             sunset - twilight, sunset, sunset + twilight]
    hour %= 24
    if hour < times[0]:
        hour += 24
    (ia, xa), (ib, xb), (ic, xc), (id_, xd) = periodic_knots(times, hour)
    ya, yb, yc, yd = (DAYLIGHT_PALETTE_TIMES[i] + round((x - times[i]) / 24) * 24
                      for i, x in ((ia, xa), (ib, xb), (ic, xc), (id_, xd)))
    h0, h, h2 = xb - xa, xc - xb, xd - xc
    d0, d1, d2 = (yb - ya) / h0, (yc - yb) / h, (yd - yc) / h2
    return hermite(yb, yc, pchip_slope(d0, d1, h0, h), pchip_slope(d1, d2, h, h2),
                   h, (hour - xb) / h) % 24


def daylight_stops(hour, sunrise=DAYLIGHT["sunrise"], sunset=DAYLIGHT["sunset"]):
    """Six (position, Oklab colour) bands for a clock hour."""
    sunrise = clamp(sunrise, *DAYLIGHT_SUNRISE_LIMITS)
    sunset = clamp(sunset, *DAYLIGHT_SUNSET_LIMITS)
    palette_hour = daylight_palette_hour(hour, sunrise, sunset)
    (ia, xa), (ib, xb), (ic, xc), (id_, xd) = periodic_knots(
        [anchor_hour for anchor_hour, _ in DAYLIGHT_ANCHORS], palette_hour)
    a, b, c, d = (DAYLIGHT_ANCHORS[i][1] for i in (ia, ib, ic, id_))
    h0, h, h2 = xb - xa, xc - xb, xd - xc
    u = (palette_hour - xb) / h
    values = []
    for k in range(len(b)):
        d0, d1, d2 = (b[k] - a[k]) / h0, (c[k] - b[k]) / h, (d[k] - c[k]) / h2
        values.append(hermite(b[k], c[k], pchip_slope(d0, d1, h0, h),
                              pchip_slope(d1, d2, h, h2), h, u))
    bend = math.log(DAYLIGHT["horizon"]) / math.log(0.9)
    return [(clamp(values[i]) ** bend, tuple(values[6 + 3 * i:9 + 3 * i])) for i in range(6)]


def daylight_color(stops, y):
    """sRGB at height `y` (0 top, 1 bottom): interpolate the bands, then
    Pond's tone curve, saturation, warmth and gamut fit."""
    i = max((j for j in range(1, 5) if y >= stops[j][0]), default=0)
    (pa, a), (pb, b), (pc, c), (pd, d) = (stops[max(i - 1, 0)], stops[i], stops[i + 1],
                                          stops[min(i + 2, 5)])
    h0, h, h2 = pb - pa, pc - pb, pd - pc
    u = (y - pb) / h
    lab = []
    for k in range(3):
        d1 = (c[k] - b[k]) / h
        m0 = pchip_slope((b[k] - a[k]) / h0, d1, h0, h) if h0 > 0 else d1
        m1 = pchip_slope(d1, (d[k] - c[k]) / h2, h, h2) if h2 > 0 else d1
        lab.append(hermite(b[k], c[k], m0, m1, h, u))
    lightness = DAYLIGHT["brightness"] * math.tanh(lab[0] / 0.75)
    ca = lab[1] * DAYLIGHT["saturation"]
    cb = lab[2] * DAYLIGHT["saturation"] + DAYLIGHT["warmth"] * lightness
    chroma = math.hypot(ca, cb)
    if chroma > DAYLIGHT_MAX_CHROMA:
        ca, cb = ca * DAYLIGHT_MAX_CHROMA / chroma, cb * DAYLIGHT_MAX_CHROMA / chroma
    color = oklab_to_srgb((lightness, ca, cb))
    for _ in range(16):
        if all(0 <= v <= 1 for v in color):
            break
        ca, cb = ca * 0.85, cb * 0.85
        color = oklab_to_srgb((lightness, ca, cb))
    return color


def sun_times(lat, lon, local_day):
    """Clock hours of sunrise and sunset on the day of `local_day` (an aware
    datetime), or Pond's 6.5 and 18.5 where the sun does not rise or set."""
    midnight = local_day.replace(hour=0, minute=0, second=0, microsecond=0)
    above = [solar_position(lat, lon, (midnight + datetime.timedelta(minutes=minute))
                            .astimezone(datetime.timezone.utc))[0] > SUN_RISE_ELEVATION
             for minute in range(0, 24 * 60, 2)]
    rises = [k for k in range(1, len(above)) if above[k] and not above[k - 1]]
    sets = [k for k in range(1, len(above)) if above[k - 1] and not above[k]]
    if not rises or not sets:
        return DAYLIGHT["sunrise"], DAYLIGHT["sunset"]
    return rises[0] / 30, sets[-1] / 30


def render_daylight(out_path, width, height, t_utc, lat, lon):
    local = t_utc.astimezone()
    hour = local.hour + local.minute / 60 + local.second / 3600
    stops = daylight_stops(hour, *sun_times(lat, lon, local))
    # The picture varies only down the screen: one column, stretched across.
    ppm_path = os.path.join(STATE_DIR, "daylight.ppm")
    with open(ppm_path, "wb") as f:
        f.write(f"P6\n1 {height}\n65535\n".encode())
        for row in range(height):
            color = daylight_color(stops, (row + 0.5) / height)
            f.write(struct.pack(">HHH", *(round(clamp(v) * 65535) for v in color)))
    temporary = out_path + ".tmp.png"
    subprocess.run([which("magick"), ppm_path, "-scale", f"{width}x{height}!",
                    "-attenuate", "0.25", "+noise", "Gaussian", "-depth", "8", temporary],
                   check=True, timeout=60)
    os.replace(temporary, out_path)


# ---------- theme inks ----------
#
# The printed styles are drawn in fixed inks, chosen by hand, and then taken
# into the theme. A theme's colours are picked to be read as text, not to
# fill a screen, so they are not used as they are: each ink keeps its own
# lightness, turns to the hue of the theme colour that stands for its
# pigment, and loses chroma where the theme has less. The sheet itself — the
# pale inks of a light theme, the dark inks of a dark one — moves onto the
# theme's background.

THEME_INKS = 1.0   # how far the inks go into the theme; 0 leaves them as printed
# The print's pigments: pink, vermilion, ochre, pale sky, Prussian blue.
INK_PIGMENTS = {"pink": "e8809a", "red": "d9532f", "ochre": "f0b97a",
                "sky": "9cc2d4", "blue": "2c66ae"}
LIGHT_THEME = 0.4  # background luminance at and above which a theme is light


def is_light(colors):
    return gray_of(colors["background"])[0] >= LIGHT_THEME


def oklab_hue(lab):
    return math.degrees(math.atan2(lab[2], lab[1])) % 360


def theme_tint(c, paper, night):
    """A function taking a printed ink (Oklab) into the theme `c`. `paper`
    and `night` are the hex colours of the style's own light and dark sheet,
    which land on the theme's background."""
    stand_ins = {"pink": lerp(c["magenta"], c["red"], 0.3), "red": c["red"],
                 "ochre": lerp(c["orange"], c["yellow"], 0.5),
                 "sky": lerp(c["blue"], c["cyan"], 0.6), "blue": c["blue"]}
    anchors = []
    for name, pigment in INK_PIGMENTS.items():
        printed, themed = srgb_to_oklab(hexrgb(pigment)), srgb_to_oklab(stand_ins[name])
        chroma = math.hypot(themed[1], themed[2])
        # A grey has no hue to turn to; it only drains the ink.
        turn = (oklab_hue(themed) - oklab_hue(printed) + 180) % 360 - 180 if chroma > 0.02 else 0.0
        anchors.append((oklab_hue(printed), turn,
                        min(1.0, chroma / math.hypot(printed[1], printed[2]))))
    anchors.sort()
    light = is_light(c)
    sheet = srgb_to_oklab(hexrgb(paper if light else night))
    move = tuple(b - s for b, s in zip(srgb_to_oklab(c["background"]), sheet))

    def tint(lab):
        lightness, a, b = lab
        hue = oklab_hue(lab)
        after = next((k for k, anchor in enumerate(anchors) if anchor[0] > hue), 0)
        (h0, turn0, keep0), (h1, turn1, keep1) = anchors[after - 1], anchors[after]
        u = ((hue - h0) % 360) / ((h1 - h0) % 360)
        on_sheet = THEME_INKS * (smoothstep(0.60, 0.90, lightness) if light
                                 else smoothstep(0.50, 0.25, lightness))
        inked = THEME_INKS * (1 - on_sheet)
        chroma = math.hypot(a, b) * (1 + (keep0 + (keep1 - keep0) * u - 1) * inked)
        hue = math.radians(hue + (turn0 + (turn1 - turn0) * u) * inked)
        return (lightness + on_sheet * move[0], chroma * math.cos(hue) + on_sheet * move[1],
                chroma * math.sin(hue) + on_sheet * move[2])
    return tint


# ---------- bokashi style ----------
#
# A sky the way a woodblock print makes one. Bokashi is the printer's wiped
# gradation: a deep band of ink along the top edge, a flat ground, and a band
# of colour rising from the horizon. On that sits a flat sun, where the sun
# is from here, and by night the moon, in its phase and leaning toward the
# sun. The inks below are the print's own; the theme chooses the stock and
# then tints them (see theme inks, above).

# Sun elevation, then the inks: top band, ground, glow above the horizon, the
# horizon itself; then how far down the top band reaches and how far up the
# horizon band does, as fractions of the sheet. Dawn is pink, dusk is red.
BOKASHI_TWILIGHT = {
    "dusk": [
        (-18, "0d1020", "1a2238", "27324a", "303c52", 0.50, 0.40),
        (-9, "111a38", "26365a", "4a4c72", "7a5a78", 0.50, 0.42),
        (-3, "1b2c5c", "50608c", "d08a8a", "c8553d", 0.46, 0.46),
        (0.5, "24468a", "a9a3b8", "f0b97a", "d9532f", 0.40, 0.50),
    ],
    "dawn": [
        (-18, "0d1020", "1a2238", "27324a", "303c52", 0.50, 0.40),
        (-9, "111a38", "26365a", "4c5078", "80648a", 0.50, 0.42),
        (-3, "1b2c5c", "56668f", "e0a0b0", "d0708a", 0.46, 0.46),
        (0.5, "24468a", "b0aabd", "f6c9b0", "e8809a", 0.40, 0.50),
    ],
}
# By day the sheet shows its stock. Under a light theme it is natural paper:
# the sky is the bare sheet between a blue band and a pale horizon. Under a
# dark theme it is indigo-dyed: the sky is printed blue and the horizon pale.
BOKASHI_DAY = {
    "paper": {
        "dusk": [(7, "2a5aa0", "e3d6c6", "f4d49a", "eaa27e", 0.34, 0.42)],
        "dawn": [(7, "2a5aa0", "e6dace", "f6dcc0", "f0b6b0", 0.34, 0.42)],
        "high": [(22, "2c66ae", "ece6d6", "ebe8d8", "d5e2dc", 0.30, 0.30),
                 (60, "2c66ae", "efeadc", "eceadc", "d2e3e0", 0.28, 0.26)],
    },
    "indigo": {
        "dusk": [(7, "244c90", "7d8fb2", "f1c58f", "e9966f", 0.38, 0.44)],
        "dawn": [(7, "244c90", "8192b6", "f3c9b6", "eda3a8", 0.38, 0.44)],
        "high": [(22, "1f4f98", "5f8abb", "a8c6d2", "e4e3cf", 0.36, 0.36),
                 (60, "1d4c96", "5587bd", "9cc2d4", "dfe5d6", 0.36, 0.32)],
    },
}
BOKASHI_SUN_LOW, BOKASHI_SUN_HIGH = "d6402b", "e8694a"
BOKASHI_MOON = "f1ead6"
BOKASHI_SUN_RADIUS = 0.060    # of the sheet's height
BOKASHI_MOON_RADIUS = 0.042
BOKASHI_ALT_TOP = 75.0        # altitude at the top edge; the bottom edge is the horizon
BOKASHI_INDIGO_DEPTH = 0.90   # lightness of the indigo sheet, against dark windows
BOKASHI_DAY_MOON = 0.5        # how much of the moon shows while the sun is up
BOKASHI_SHEETS = ("ece6d6", "1a2238")   # the paper, and the ground at night


def moon_position(lat, lon, t_utc):
    """(altitude, azimuth-from-north, illuminated fraction, waxing) of the
    moon. Low-precision series, good to a fraction of a degree."""
    days = t_utc.timestamp() / 86400 + 2440587.5 - 2451545.0
    t = days / 36525
    sin, cos, rad = (lambda d: math.sin(math.radians(d))), (lambda d: math.cos(math.radians(d))), math.radians
    lam = (218.32 + 481267.881 * t + 6.29 * sin(135.0 + 477198.87 * t)
           - 1.27 * sin(259.3 - 413335.36 * t) + 0.66 * sin(235.7 + 890534.22 * t)
           + 0.21 * sin(269.9 + 954397.74 * t) - 0.19 * sin(357.5 + 35999.05 * t)
           - 0.11 * sin(186.5 + 966404.03 * t))
    beta = (5.13 * sin(93.3 + 483202.02 * t) + 0.28 * sin(228.2 + 960400.89 * t)
            - 0.28 * sin(318.3 + 6003.15 * t) - 0.17 * sin(217.6 - 407332.21 * t))
    tilt = 23.439 - 0.0000004 * days
    x = cos(beta) * cos(lam)
    y = cos(tilt) * cos(beta) * sin(lam) - sin(tilt) * sin(beta)
    z = sin(tilt) * cos(beta) * sin(lam) + cos(tilt) * sin(beta)
    hour_angle = local_sidereal_angle(t_utc, lon) - math.atan2(y, x)
    dec, lat_r = math.asin(z), rad(lat)
    alt = math.degrees(math.asin(clamp(math.sin(lat_r) * math.sin(dec)
                                       + math.cos(lat_r) * math.cos(dec) * math.cos(hour_angle),
                                       -1.0, 1.0)))
    alt -= 0.95 * cos(alt)   # the moon is near enough for parallax to lower it
    az = math.degrees(math.atan2(
        math.sin(hour_angle),
        math.cos(hour_angle) * math.sin(lat_r) - math.tan(dec) * math.cos(lat_r)))
    anomaly = 357.528 + 0.9856003 * days
    sun = 280.460 + 0.9856474 * days + 1.915 * sin(anomaly) + 0.020 * sin(2 * anomaly)
    elongation = (lam - sun) % 360
    return alt, (az + 180) % 360, (1 - cos(elongation)) / 2, elongation < 180


def bokashi_inks(elev, morning, stock="paper"):
    """The four inks (Oklab) and two band extents for a sun elevation."""
    half = "dawn" if morning else "dusk"
    keys = BOKASHI_TWILIGHT[half] + BOKASHI_DAY[stock][half] + BOKASHI_DAY[stock]["high"]
    elev = clamp(elev, keys[0][0], keys[-1][0])
    k = max(i for i in range(len(keys) - 1) if elev >= keys[i][0])
    low, high = keys[k], keys[k + 1]
    t = smoothstep(low[0], high[0], elev)
    inks = [lerp(srgb_to_oklab(hexrgb(low[i])), srgb_to_oklab(hexrgb(high[i])), t)
            for i in range(1, 5)]
    return inks, low[5] + (high[5] - low[5]) * t, low[6] + (high[6] - low[6]) * t


def bokashi_color(inks, top_reach, horizon_reach, y):
    """Oklab at height `y` (0 top, 1 bottom): each band wiped into the ground."""
    top, ground, glow, horizon = inks
    stops = [(0.0, top), (top_reach, ground), (1 - horizon_reach, ground),
             (1 - 0.42 * horizon_reach, glow), (1.0, horizon)]
    for (y0, c0), (y1, c1) in zip(stops, stops[1:]):
        if y <= y1:
            return lerp(c0, c1, smoothstep(y0, y1, y))
    return horizon


def bokashi_screen(az, alt, lat):
    """Where a bearing and altitude fall on the sheet, as fractions of its
    width and height. The sheet faces the sun's side of the sky: south in the
    northern hemisphere, north in the southern; the bottom edge is the horizon."""
    if lat >= 0:
        x = 0.5 + (az - 180) / AZ_SPAN
    else:
        x = 0.5 + ((az + 180) % 360 - 180) / AZ_SPAN
    return x, 1 - alt / BOKASHI_ALT_TOP


def moon_outline(cx, cy, radius, fraction, toward):
    """The lit part of the moon as polygon points: the limb on the side
    facing `toward` (radians, screen angle), closed by the terminator."""
    points = []
    steps = 48
    for k in range(steps + 1):
        a = -math.pi / 2 + math.pi * k / steps
        points.append((radius * math.cos(a), radius * math.sin(a)))
    for k in range(steps + 1):
        a = math.pi / 2 - math.pi * k / steps
        points.append((radius * math.cos(a) * (1 - 2 * fraction), radius * math.sin(a)))
    c, s = math.cos(toward), math.sin(toward)
    return [(cx + x * c - y * s, cy + x * s + y * c) for x, y in points]


def render_bokashi(out_path, width, height, t_utc, lat, lon, colors):
    elev, az = solar_position(lat, lon, t_utc)
    stock = "paper" if is_light(colors) else "indigo"
    inks, top_reach, horizon_reach = bokashi_inks(elev, az < 180, stock)
    depth = BOKASHI_INDIGO_DEPTH if stock == "indigo" else 1.0
    tint = theme_tint(colors, *BOKASHI_SHEETS)

    def paint(lab):
        return oklab_to_srgb(tint((lab[0] * depth, lab[1], lab[2])))

    def rgba(hexcolor, alpha):
        r, g, b = (round(clamp(v) * 255) for v in paint(srgb_to_oklab(hexrgb(hexcolor))))
        return f"rgba({r},{g},{b},{alpha:.3f})"

    sheet = os.path.join(STATE_DIR, "bokashi.ppm")
    with open(sheet, "wb") as f:
        f.write(f"P6\n1 {height}\n65535\n".encode())
        for row in range(height):
            color = paint(bokashi_color(inks, top_reach, horizon_reach, (row + 0.5) / height))
            f.write(struct.pack(">HHH", *(round(clamp(v) * 65535) for v in color)))
    # The sun and moon sink into the horizon band rather than being cut by the edge.
    mist = os.path.join(STATE_DIR, "bokashi-mist.pgm")
    with open(mist, "wb") as f:
        f.write(f"P5\n1 {height}\n65535\n".encode())
        for row in range(height):
            f.write(struct.pack(">H", round(smoothstep(1.0, 0.86, (row + 0.5) / height) * 65535)))

    draw = []
    sun_x, sun_y = bokashi_screen(az, elev, lat)
    radius = BOKASHI_SUN_RADIUS * height
    if sun_y * height - radius < height:
        ink = lerp(hexrgb(BOKASHI_SUN_LOW), hexrgb(BOKASHI_SUN_HIGH), smoothstep(0, 40, elev))
        ink = "".join(f"{round(v * 255):02x}" for v in ink)
        cx, cy = sun_x * width, sun_y * height
        draw += ["-fill", rgba(ink, 1.0), "-draw", f"circle {cx:.1f},{cy:.1f} {cx + radius:.1f},{cy:.1f}"]
    moon_alt, moon_az, fraction, _ = moon_position(lat, lon, t_utc)
    moon_x, moon_y = bokashi_screen(moon_az, moon_alt, lat)
    radius = BOKASHI_MOON_RADIUS * height
    shown = max(smoothstep(8, -4, elev), BOKASHI_DAY_MOON)
    if shown > 0 and moon_y * height - radius < height:
        cx, cy = moon_x * width, moon_y * height
        toward = math.atan2((sun_y - moon_y) * height, (sun_x - moon_x) * width)
        outline = " ".join(f"{x:.1f},{y:.1f}" for x, y in moon_outline(cx, cy, radius, fraction, toward))
        draw += ["-fill", rgba(BOKASHI_MOON, 0.10 * shown),
                 "-draw", f"circle {cx:.1f},{cy:.1f} {cx + radius:.1f},{cy:.1f}",
                 "-fill", rgba(BOKASHI_MOON, 0.95 * shown), "-draw", f"polygon {outline}"]

    cmd = [which("magick"), sheet, "-scale", f"{width}x{height}!"]
    if draw:
        cmd += ["(", "-size", f"{width}x{height}", "xc:none", *draw,
                "(", mist, "-scale", f"{width}x{height}!", "-alpha", "copy", ")",
                "-compose", "DstIn", "-composite", ")", "-compose", "Over", "-composite"]
    temporary = out_path + ".tmp.png"
    subprocess.run(cmd + ["-attenuate", "0.25", "+noise", "Gaussian", "-depth", "8", temporary],
                   check=True, timeout=60)
    os.replace(temporary, out_path)


# ---------- cyanotype style ----------
#
# A sun print of the sun. Where the other styles paint the sky, this one
# charts it, white on Prussian blue: the whole compass unrolled across the
# sheet, the horizon a ruled line, and the sun's path for today a wave over
# and under it — a dot for each hour, solid where the sun has been and dotted
# where it has yet to go. Behind it, faintly, the waves of the solstices and
# the equinox: the most and least the sun ever does here. The blue deepens
# from day to night, and the twilights are a wash that seeps under the horizon.

CYANOTYPE = {
    # line, then sky and earth by day, then sky and earth by night
    "blue": ("e8eef5", "23559b", "1a4380", "0d1b3a", "0a1530"),
    "paper": ("1d4c8f", "f0f3f2", "e2e8ea", "c3cedb", "b3c0d0"),
}
CYANOTYPE_SHEETS = ("f0f3f2", "0d1b3a")   # the paper, and the sky at night
CYANOTYPE_HORIZON = 0.56      # how far down the sheet the horizon is ruled
CYANOTYPE_ALT_SCALE = 0.5     # of the sheet's height, for 90 degrees of altitude
CYANOTYPE_SUN_RADIUS = 0.014
CYANOTYPE_MOON_RADIUS = 0.011
CYANOTYPE_REFERENCE_DAYS = ((6, 21), (3, 20), (12, 21))


def cyanotype_centre(lat, lon, local_day):
    """The bearing at the middle of the sheet: south or north, whichever the
    sun stands in at its highest today. In the tropics that turns with the
    season."""
    midnight = local_day.replace(hour=0, minute=0, second=0, microsecond=0)
    _, az = max(solar_position(lat, lon, (midnight + datetime.timedelta(minutes=minute))
                               .astimezone(datetime.timezone.utc))
                for minute in range(0, 24 * 60, 10))
    return 180 if 90 <= az < 270 else 0


def cyanotype_screen(az, alt, centre=180):
    """Fractions of the sheet's width and height for a bearing and altitude.
    The full circle of the horizon runs across the sheet, with the bearing
    `centre` in the middle."""
    x = 0.5 + ((az - centre + 180) % 360 - 180) / 360
    return x, CYANOTYPE_HORIZON - alt / 90 * CYANOTYPE_ALT_SCALE


def sun_wave(lat, lon, local_day, centre=180, step=10):
    """The sun through one local day: (minute, x, y) every `step` minutes."""
    midnight = local_day.replace(hour=0, minute=0, second=0, microsecond=0)
    wave = []
    for minute in range(0, 24 * 60 + 1, step):
        instant = (midnight + datetime.timedelta(minutes=minute)).astimezone(datetime.timezone.utc)
        elev, az = solar_position(lat, lon, instant)
        wave.append((minute, *cyanotype_screen(az, elev, centre)))
    return wave


def wave_runs(wave):
    """Split a wave where it leaves one edge of the sheet and enters the other."""
    runs = [[]]
    for point in wave:
        if runs[-1] and abs(point[1] - runs[-1][-1][1]) > 0.5:
            runs.append([])
        runs[-1].append(point)
    return [run for run in runs if len(run) > 1]


def cyanotype_ground(elev, alt, sky_day, earth_day, sky_night, earth_night, line):
    """The wash at an altitude on the sheet, for the sun's elevation."""
    exposure = smoothstep(-12, 10, elev)
    sky = lerp(sky_night, sky_day, exposure)
    earth = lerp(earth_night, earth_day, exposure)
    if alt >= 0:
        # A little lighter toward the horizon, as skies are.
        return lerp(sky, line, 0.07 * smoothstep(40, 0, alt))
    return lerp(earth, lerp(sky, line, 0.07), 0.6 * smoothstep(-18, 0, alt))


def cyanotype_inks(colors):
    """The line and the four washes (Oklab) in the theme's colours. On the
    blue sheet the line is the theme's foreground; on paper it is its blue."""
    tint = theme_tint(colors, *CYANOTYPE_SHEETS)
    line, *washes = (tint(srgb_to_oklab(hexrgb(c)))
                     for c in CYANOTYPE["paper" if is_light(colors) else "blue"])
    if not is_light(colors):
        printed = srgb_to_oklab(hexrgb(CYANOTYPE["blue"][0]))
        line = lerp(printed, srgb_to_oklab(colors["foreground"]), THEME_INKS)
    return line, washes


def render_cyanotype(out_path, width, height, t_utc, lat, lon, colors):
    line, washes = cyanotype_inks(colors)
    line_hex = "#" + "".join(f"{round(clamp(v) * 255):02x}" for v in oklab_to_srgb(line))
    elev, az = solar_position(lat, lon, t_utc)
    local = t_utc.astimezone()
    now_minute = local.hour * 60 + local.minute + local.second / 60

    sheet = os.path.join(STATE_DIR, "cyanotype.ppm")
    with open(sheet, "wb") as f:
        f.write(f"P6\n1 {height}\n65535\n".encode())
        for row in range(height):
            alt = (CYANOTYPE_HORIZON - (row + 0.5) / height) / CYANOTYPE_ALT_SCALE * 90
            color = oklab_to_srgb(cyanotype_ground(elev, alt, *washes, line))
            f.write(struct.pack(">HHH", *(round(clamp(v) * 65535) for v in color)))

    unit = height / 1200   # a hairline
    mvg = ["stroke-linecap round", "stroke-linejoin round", f"stroke {line_hex}", "fill none"]

    def polyline(points, opacity, weight, dash=None):
        mvg.append(f"stroke-opacity {opacity} stroke-width {weight * unit:.2f} "
                   f"stroke-dasharray {dash or 'none'}")
        mvg.append("polyline " + " ".join(f"{x * width:.1f},{y * height:.1f}" for _, x, y in points))

    def dot(x, y, radius, opacity, hollow=False):
        cx, cy, r = x * width, y * height, radius
        if hollow:
            mvg.append(f"fill none fill-opacity 0 stroke-opacity {opacity} "
                       f"stroke-width {1.4 * unit:.2f} stroke-dasharray none")
        else:
            mvg.append(f"fill {line_hex} fill-opacity {opacity} stroke-opacity 0")
        mvg.append(f"circle {cx:.1f},{cy:.1f} {cx + r:.1f},{cy:.1f}")
        mvg.append("fill none fill-opacity 0")

    # The horizon, the compass along it, and the three depths of twilight.
    horizon = CYANOTYPE_HORIZON
    polyline([(0, 0, horizon), (0, 1, horizon)], 0.55, 1.0)
    centre = cyanotype_centre(lat, lon, local)
    for bearing in range(0, 360, 15):
        reach = 0.012 if bearing % 90 == 0 else 0.006 if bearing % 45 == 0 else 0.003
        x = bearing / 360
        polyline([(0, x, horizon - reach), (0, x, horizon + reach)], 0.55, 1.0)
    for depth in (6, 12, 18):
        y = horizon + depth / 90 * CYANOTYPE_ALT_SCALE
        polyline([(0, 0, y), (0, 1, y)], 0.16, 0.8, f"{unit:.2f} {7 * unit:.2f}")

    # The year's extremes, then today: travelled, and still to come.
    for month, day in CYANOTYPE_REFERENCE_DAYS:
        for run in wave_runs(sun_wave(lat, lon, local.replace(month=month, day=day), centre)):
            polyline(run, 0.17, 0.8)
    today = sun_wave(lat, lon, local, centre)
    for run in wave_runs([p for p in today if p[0] <= now_minute]):
        polyline(run, 0.85, 1.5)
    for run in wave_runs([p for p in today if p[0] >= now_minute]):
        polyline(run, 0.5, 1.2, f"{unit:.2f} {5 * unit:.2f}")
    for minute, x, y in today[:-1]:
        if minute % 60 == 0:
            hour = minute // 60
            dot(x, y, (3.4 if hour % 6 == 0 else 2.2) * unit, 0.85 if minute <= now_minute else 0.5)

    # The moon in its phase, and the sun: solid above the horizon, a ring below.
    moon_alt, moon_az, fraction, _ = moon_position(lat, lon, t_utc)
    sun_x, sun_y = cyanotype_screen(az, elev, centre)
    moon_x, moon_y = cyanotype_screen(moon_az, moon_alt, centre)
    radius = CYANOTYPE_MOON_RADIUS * height
    toward = math.atan2((sun_y - moon_y) * height, (sun_x - moon_x) * width)
    outline = moon_outline(moon_x * width, moon_y * height, radius, fraction, toward)
    dot(moon_x, moon_y, radius, 0.35, hollow=True)
    mvg.append(f"fill {line_hex} fill-opacity 0.85 stroke-opacity 0")
    mvg.append("polygon " + " ".join(f"{x:.1f},{y:.1f}" for x, y in outline))
    mvg.append("fill none fill-opacity 0")
    radius = CYANOTYPE_SUN_RADIUS * height
    if elev > 0:
        dot(sun_x, sun_y, radius * 3.2, 0.07)
        dot(sun_x, sun_y, radius * 1.9, 0.12)
        dot(sun_x, sun_y, radius, 1.0)
    else:
        ground = oklab_to_srgb(cyanotype_ground(elev, elev, *washes, line))
        mvg.append("fill #" + "".join(f"{round(clamp(v) * 255):02x}" for v in ground)
                   + " fill-opacity 1 stroke-opacity 0")
        mvg.append(f"circle {sun_x * width:.1f},{sun_y * height:.1f} "
                   f"{sun_x * width + radius:.1f},{sun_y * height:.1f}")
        mvg.append("fill none fill-opacity 0")
        dot(sun_x, sun_y, radius, 0.9, hollow=True)

    mvg_path = os.path.join(STATE_DIR, "cyanotype.mvg")
    with open(mvg_path, "w") as f:
        f.write("\n".join(mvg) + "\n")
    temporary = out_path + ".tmp.png"
    subprocess.run([which("magick"), sheet, "-scale", f"{width}x{height}!", "-draw", f"@{mvg_path}",
                    "-attenuate", "0.25", "+noise", "Gaussian", "-depth", "8", temporary],
                   check=True, timeout=60)
    os.replace(temporary, out_path)


# ---------- gradient style ----------
#
# A plain gradient, but one that knows where the sun is. It is not a picture
# of the sky: it is light falling off from a source. The source stands far
# off the screen in the sun's direction, so the gradient turns once a day
# like the shadow on a sundial — lit from the left at sunrise, from above at
# noon, from the right at sunset and from below at night — and its colours
# run from the colour of the light to the colour of what the light has not
# reached. The colours are the style's own, tinted by the theme.

# Sun elevation, then five colours from the lit end of the screen to the far
# end. Dawn runs pink and cool, dusk gold and red, as in bokashi.
GRADIENT_NIGHT = [(-18, "34407a", "262f62", "1a2149", "121736", "0c0f26")]
GRADIENT_TWILIGHT = {
    "dawn": [
        (-10, "6a5a96", "433f80", "2a2d62", "1a1e48", "0f1332"),
        (-4, "f2a493", "cf7c9f", "8c69b0", "4d569f", "263670"),
        (0.5, "ffd6a3", "f79c90", "c97db3", "7d7cc9", "3f5cb0"),
        (7, "ffedc6", "f8c6ac", "d6a8cc", "8ba6e2", "4c7bd0"),
    ],
    "dusk": [
        (-10, "7c4f84", "4b3c7c", "2c2b60", "1a1d47", "0f1231"),
        (-4, "f08a5e", "c9567c", "7c4a98", "3e3a86", "1e2459"),
        (0.5, "ffc06e", "f47b55", "c14d85", "6c4ba5", "2e3a8d"),
        (7, "ffdf9c", "f8aa6c", "e07d8e", "8b79c8", "4068c0"),
    ],
}
GRADIENT_DAY = [
    (18, "ffefc8", "f0dde6", "a3c6f0", "5591e5", "3a5fc6"),
    (40, "fff6dc", "dcecfa", "86c3f7", "418cee", "3058d0"),
]
GRADIENT_SHEETS = ("fffaf0", "1a2149")   # the lightest of the day, the middle of the night
GRADIENT_GRID = 64            # the field is this many cells across before it is enlarged
GRADIENT_LEAN = 0.6           # how far a low sun tips the gradient onto its side
GRADIENT_LIFT = 0.35          # holds the light overhead a while past sunset
GRADIENT_DISTANCE = 2.5       # of the screen's height, from its centre to the light
GRADIENT_REACH = 0.75         # below 1, the light gives way to colour sooner
GRADIENT_DARK_DEPTH = 0.96    # lightness under a dark theme, against dark windows


def cubic_ramp(stops, t):
    """A smooth curve through evenly spaced `stops` (tuples) at `t` in 0..1,
    shape-preserving, so the bands of a gradient meet without creases."""
    last = len(stops) - 1
    t = clamp(t) * last
    i = min(int(t), last - 1)
    a, b, c, d = stops[max(i - 1, 0)], stops[i], stops[i + 1], stops[min(i + 2, last)]
    out = []
    for k in range(len(b)):
        rise = c[k] - b[k]
        m0 = pchip_slope(b[k] - a[k], rise, 1, 1) if i > 0 else rise
        m1 = pchip_slope(rise, d[k] - c[k], 1, 1) if i + 1 < last else rise
        out.append(hermite(b[k], c[k], m0, m1, 1, t - i))
    return tuple(out)


def gradient_ramp(elev, morning):
    """The five colours (Oklab), lit end first, for a sun elevation."""
    keys = GRADIENT_NIGHT + GRADIENT_TWILIGHT["dawn" if morning else "dusk"] + GRADIENT_DAY
    elev = clamp(elev, keys[0][0], keys[-1][0])
    k = max(i for i in range(len(keys) - 1) if elev >= keys[i][0])
    low, high = keys[k], keys[k + 1]
    t = smoothstep(low[0], high[0], elev)
    return [lerp(srgb_to_oklab(hexrgb(low[i])), srgb_to_oklab(hexrgb(high[i])), t)
            for i in range(1, 6)]


def gradient_light(elev, az, lat):
    """The direction of the light on the screen, as a unit vector (x right,
    y up): the sun's direction seen facing its side of the sky — south in
    the northern hemisphere, north in the southern — with east and west
    drawn in a little, so the gradient leans rather than lies down."""
    side = -1 if lat >= 0 else 1
    x = side * math.sin(math.radians(az)) * math.cos(math.radians(elev)) * GRADIENT_LEAN
    y = math.sin(math.radians(elev)) + GRADIENT_LIFT
    length = math.hypot(x, y)
    return (x / length, y / length) if length > 1e-6 else (0.0, 1.0)


def gradient_field(elev, az, lat, aspect):
    """Rows of values 0..1 — 0 nearest the light, 1 farthest — on a small
    grid of the screen's proportions."""
    gw = GRADIENT_GRID
    gh = max(2, round(gw / aspect))
    dx, dy = gradient_light(elev, az, lat)
    lx, ly = dx * GRADIENT_DISTANCE, dy * GRADIENT_DISTANCE
    rows = [[math.hypot((gx / (gw - 1) - 0.5) * aspect - lx, 0.5 - gy / (gh - 1) - ly)
             for gx in range(gw)] for gy in range(gh)]
    near, far = min(map(min, rows)), max(map(max, rows))
    return [[((r - near) / (far - near)) ** GRADIENT_REACH for r in row] for row in rows]


def render_gradient(out_path, width, height, t_utc, lat, lon, colors):
    elev, az = solar_position(lat, lon, t_utc)
    ramp = gradient_ramp(elev, az < 180)
    tint = theme_tint(colors, *GRADIENT_SHEETS)
    depth = 1.0 if is_light(colors) else GRADIENT_DARK_DEPTH
    field = gradient_field(elev, az, lat, width / height)
    ppm_path = os.path.join(STATE_DIR, "gradient.ppm")
    with open(ppm_path, "wb") as f:
        f.write(f"P6\n{len(field[0])} {len(field)}\n65535\n".encode())
        for row in field:
            for value in row:
                lab = cubic_ramp(ramp, value)
                color = oklab_to_srgb(tint((lab[0] * depth, lab[1], lab[2])))
                f.write(struct.pack(">HHH", *(round(clamp(v) * 65535) for v in color)))
    temporary = out_path + ".tmp.png"
    subprocess.run([which("magick"), ppm_path, "-resize", f"{width}x{height}!",
                    "-attenuate", "0.25", "+noise", "Gaussian", "-depth", "8", temporary],
                   check=True, timeout=60)
    os.replace(temporary, out_path)


# ---------- slitscan style ----------
#
# A whole day in one picture, the way a slit-scan camera makes one: every
# column of the screen is the sky at a different moment. Now is the middle
# column; the twelve hours gone run out to the left edge and the twelve to
# come to the right, so the night is as wide as the night is long, and the
# picture slides a column to the left every few minutes. Each column is the
# sky style's sky for its moment, from the zenith at the top down to the
# horizon, in the theme's colours, without the weather.

SLITSCAN_HOURS = 24.0         # the span of time across the screen
SLITSCAN_GRID = (192, 40)
SLITSCAN_SUNWARD = 0.65       # how far each horizon leans to its sunward colour


def slitscan_hour(x):
    """Hours from now, negative for the past, at `x` across the screen (0..1)."""
    return (x - 0.5) * SLITSCAN_HOURS


def sky_column(c, elev, rows):
    """The sky style's clear sky for a sun elevation as one column of
    colours, zenith first: the far and sunward horizons mixed into one."""
    zenith, far, near = sky_stops(elev, c)
    horizon = lerp(far, near, SLITSCAN_SUNWARD)
    night = c.get("darker_background", c["background"])
    height = 18.0 + 30.0 * clamp(elev / 30)
    brightness = clamp((elev + 18) / 18)
    column = []
    for row in range(rows):
        v = math.exp(-ALT_TOP * (1 - row / (rows - 1)) / height)
        column.append(lerp(night, lerp(zenith, horizon, v), brightness + (1 - brightness) * v))
    return column


def render_slitscan(out_path, width, height, t_utc, lat, lon, colors):
    gw, gh = SLITSCAN_GRID
    columns = []
    for gx in range(gw):
        moment = t_utc + datetime.timedelta(hours=slitscan_hour(gx / (gw - 1)))
        columns.append(sky_column(colors, solar_position(lat, lon, moment)[0], gh))
    ppm_path = os.path.join(STATE_DIR, "slitscan.ppm")
    with open(ppm_path, "wb") as f:
        f.write(f"P6\n{gw} {gh}\n65535\n".encode())
        for row in range(gh):
            for column in columns:
                f.write(struct.pack(">HHH", *(round(clamp(v) * 65535) for v in column[row])))
    temporary = out_path + ".tmp.png"
    subprocess.run([which("magick"), ppm_path, "-resize", f"{width}x{height}!",
                    "-attenuate", "0.25", "+noise", "Gaussian", "-depth", "8", temporary],
                   check=True, timeout=60)
    os.replace(temporary, out_path)


# ---------- window style ----------
#
# Not the sky but what it does indoors: a bare room, seen from where its
# window wall would be, looking at the wall the window faces. The window
# faces the sun's side of the sky and the sun throws its panes into the room
# as it really would. Each point of each surface looks back along the light
# to see whether glass or bar is in the way, so the shapes are the true ones:
# upright on the far wall when the sun is low, sliding down it and out
# across the floor as the sun climbs, sheared along a side wall when the
# light comes from round to one side. Light that only grazes a surface lies
# on it thinly. Edges blur with the length of the ray, the grey of the sky
# comes in through the same window and falls away into the corners, and what
# the sun lights lights the rest of the room in its turn, in its own colour.
# Cloud softens the panes and then puts them out. At night the moon does the
# same, faintly, by its phase. The one liberty: light from far round to the
# side is turned back toward the room, or a summer sunrise, which comes from
# behind the window's wall, would not come in at all.

# The room in the dark, in the shade by day, and in the sun when it is low
# and when it is high; then in moonlight. The theme chooses the stock.
WINDOW_INKS = {
    "dark": ("161d30", "46547a", "f5823f", "f7e3c0", "8a9cc8"),
    "light": ("8189a0", "d2cec4", "f6a468", "fffaf0", "c9d3ea"),
}
WINDOW_SHEETS = ("fffaf0", "161d30")   # the sunlit wall, and the room at night
WINDOW_ROOM = (2.2, 1.5)      # the room's width and depth, in its own heights
WINDOW_GLASS = (0.9, 0.14, 0.9)   # the window's width, and its sill and head above the floor
WINDOW_PANES = (3, 3)         # across and up
WINDOW_BAR = 0.034            # the glazing bars' thickness
WINDOW_EYE = (1.5, 0.7)       # how far behind the window's wall the eye stands, and how high
WINDOW_FLOOR = 0.42           # how much of the screen's height the floor takes, below the wall
WINDOW_SWING = 65.0           # the widest the light may come in from the side, in degrees
WINDOW_SUN_WIDTH = 0.04       # the sun's disc in radians, and more for the glass:
                              # what softens a shadow's edge, more the further it is thrown
WINDOW_CLOUD_WIDTH = 0.12     # how much wider a full cloud cover makes the source
WINDOW_HAZE = (0.3, 0.14)     # the share of the light that comes from the glow round the
                              # sun rather than its disc, and that glow's width in radians
WINDOW_GRAZE = 0.5            # how gently light dims as it slants: 1 is Lambert's law
WINDOW_SKY = 9.0              # how strongly the sky's light through the window fills the room
WINDOW_BOUNCE = 5.0           # how strongly what the sun lights lights the rest
WINDOW_MOONLIGHT = 0.3        # the full moon's patch, against the sun's
WINDOW_SCALE = 4              # the room is rendered at this fraction of the screen
WINDOW_GLOW_SCALE = 3         # and its indirect light at this fraction of that


def window_bearing(az, lat):
    """The light's bearing off the window's own, in degrees, east negative
    for a south window: the window faces south in the northern hemisphere and
    north in the southern. Near the window's own bearing it is the true one;
    toward the sides it is eased, never passing WINDOW_SWING, so that a sun
    far round to the east or west still comes in."""
    facing = 180 if lat >= 0 else 0
    return WINDOW_SWING * math.tanh(((az - facing + 180) % 360 - 180) / WINDOW_SWING)


def window_light(alt, bearing):
    """The unit vector from the room toward the light: x to the right as the
    eye sees it, y away from the window into the room, z up. The eye has the
    window at its back, so a morning sun is at its right shoulder in the
    northern hemisphere and throws its light to the left."""
    a, b = math.radians(alt), math.radians(bearing)
    return (-math.sin(b) * math.cos(a), -math.cos(b) * math.cos(a), math.sin(a))


def window_view(u, v):
    """What the eye sees through a point of the screen, `u` to the right of
    its centre and `v` above, in screen heights: (point of the room, the
    surface's normal there). The floor is z = 0 and the window's wall y = 0.
    The eye looks level, as an architect's camera does, so that uprights
    stay upright, and the picture is slid up until the floor runs from the
    window's wall at the screen's foot to the far wall WINDOW_FLOOR above it."""
    width, depth = WINDOW_ROOM
    back, eye = WINDOW_EYE
    focal = WINDOW_FLOOR / (eye / back - eye / (depth + back))
    v -= focal * eye / back - 0.5
    reach, normal = (depth + back) / focal, (0.0, -1.0, 0.0)
    if v < 0 and eye / -v < reach:
        reach, normal = eye / -v, (0.0, 0.0, 1.0)
    if v > 0 and (1 - eye) / v < reach:
        reach, normal = (1 - eye) / v, (0.0, 0.0, -1.0)
    if u and width / 2 / abs(u) < reach:
        reach, normal = width / 2 / abs(u), (-math.copysign(1.0, u), 0.0, 0.0)
    return (u * reach, focal * reach - back, eye + v * reach), normal


def window_landing(x, z, light):
    """Where light through a point of the glass lands: (point, normal)."""
    width, depth = WINDOW_ROOM
    dx, dy, dz = -light[0], -light[1], -light[2]
    reach, normal = depth / dy, (0.0, -1.0, 0.0)
    if dz < 0 and z / -dz < reach:
        reach, normal = z / -dz, (0.0, 0.0, 1.0)
    if dx and (width / 2 - math.copysign(x, dx)) / abs(dx) < reach:
        reach, normal = (width / 2 - math.copysign(x, dx)) / abs(dx), (-math.copysign(1.0, dx), 0.0, 0.0)
    return (x + dx * reach, dy * reach, z + dz * reach), normal


def pane_cover(u, low, high, count, bar, soft):
    """How much of a source `soft` wide, centred at `u`, shows through
    `count` panes dividing `low`..`high`, with bars `bar` thick between."""
    if not low - soft / 2 < u < high + soft / 2:
        return 0.0
    pitch = (high - low) / count
    total = 0.0
    for k in range(count):
        a, b = low + k * pitch + bar / 2, low + (k + 1) * pitch - bar / 2
        total += smoothstep(-0.5, 0.5, (u - a) / soft) - smoothstep(-0.5, 0.5, (u - b) / soft)
    return total


def window_sources(cloud):
    """The light as ((share, angular width), ...): the sun's disc and the
    glow of the air round it, so an edge has a narrow blur inside a wide
    faint one. Cloud widens both and moves light from the disc to the glow."""
    haze, haze_width = WINDOW_HAZE
    haze += (1 - haze) * 0.6 * cloud
    return ((1 - haze, WINDOW_SUN_WIDTH + WINDOW_CLOUD_WIDTH * cloud),
            (haze, haze_width + WINDOW_CLOUD_WIDTH * cloud))


def window_trace(point, light):
    """Back along the light from a point of the room to the window's wall:
    (distance across the wall from the window's middle, height up it, length
    of the ray), or None if the light does not come from the window's side."""
    if light[1] > -0.02 or point[1] <= 0:
        return None
    ray = point[1] / -light[1]
    return point[0] + light[0] * ray, point[2] + light[2] * ray, ray


def window_cover(x, z, ray, sources, grain=(0.0, 0.0)):
    """How much of the light shows through the panes, 0..1, from the far
    end of a ray traced back to (`x`, `z`) on the window's wall. The edges
    blur by the ray's length, and by `grain`, the size across and up the
    wall of what one cell of the picture takes in."""
    width, sill, head = WINDOW_GLASS
    across, up = WINDOW_PANES
    total = 0.0
    for share, wide in sources:
        soft = max(wide * ray, 0.012)
        rise = pane_cover(z, sill, head, up, WINDOW_BAR, soft + grain[1])
        if rise > 0.0005:
            total += share * rise * pane_cover(x, -width / 2, width / 2, across, WINDOW_BAR,
                                               soft + grain[0])
    return total


def window_lamps(light=None):
    """The panes as lamps, [(point, normal, power)]. With no `light` they
    are the panes themselves, glowing with the sky; with one, they are the
    places in the room where its light through each pane lands, which shine
    back by as much as came through the glass."""
    width, sill, head = WINDOW_GLASS
    across, up = WINDOW_PANES
    area = width * (head - sill) / (across * up)
    lamps = []
    for i in range(across):
        for k in range(up):
            x, z = ((i + 0.5) / across - 0.5) * width, sill + (k + 0.5) / up * (head - sill)
            if light is None:
                lamps.append(((x, 0.0, z), (0.0, 1.0, 0.0), area))
            elif light[1] < -0.02:
                lamps.append((*window_landing(x, z, light), area * -light[1]))
    return lamps


def window_glow(point, normal, lamps):
    """The light a point of the room gets from a set of lamps: each shines
    most straight out from its surface, falls off with the square of the
    distance, and lights best what faces it."""
    total = 0.0
    for at, facing, power in lamps:
        dx, dy, dz = point[0] - at[0], point[1] - at[1], point[2] - at[2]
        r2 = dx * dx + dy * dy + dz * dz + 0.1
        out = dx * facing[0] + dy * facing[1] + dz * facing[2]
        into = -(dx * normal[0] + dy * normal[1] + dz * normal[2])
        if out > 0 and into > 0:
            total += power * out * into / (math.pi * r2 * r2)
    return total


def sample_grid(rows, u, v):
    """The grid's value at fractions `u` across and `v` down, between cells."""
    x = clamp(u * len(rows[0]) - 0.5, 0, len(rows[0]) - 1.001)
    y = clamp(v * len(rows) - 0.5, 0, len(rows) - 1.001)
    x0, y0 = int(x), int(y)
    fx, fy = x - x0, y - y0
    top = rows[y0][x0] * (1 - fx) + rows[y0][x0 + 1] * fx
    bottom = rows[y0 + 1][x0] * (1 - fx) + rows[y0 + 1][x0 + 1] * fx
    return top * (1 - fy) + bottom * fy


def window_strengths(elev, moon_alt, moon_fraction, cloud):
    """(ambient, sun, moon): how much daylight fills the room, and how
    strongly the sun and the moon each throw the window into it."""
    clear = (1 - cloud) ** 1.5
    ambient = smoothstep(-9, 8, elev) * (1 - 0.2 * cloud)
    sun = smoothstep(-0.8, 2, elev) * clear
    moon = (WINDOW_MOONLIGHT * moon_fraction * smoothstep(0, 8, moon_alt)
            * smoothstep(-5, -12, elev) * clear)
    return ambient, sun, moon


def render_window(out_path, width, height, t_utc, lat, lon, cloud, fog, colors):
    if fog:
        cloud = max(cloud, 0.9)
    elev, az = solar_position(lat, lon, t_utc)
    moon_alt, moon_az, fraction, _ = moon_position(lat, lon, t_utc)
    ambient, sun, moon = window_strengths(elev, moon_alt, fraction, cloud)
    tint = theme_tint(colors, *WINDOW_SHEETS)
    night, shade, low, high, moonlit = (
        tint(srgb_to_oklab(hexrgb(ink))) for ink in WINDOW_INKS["light" if is_light(colors) else "dark"])
    sunlit = lerp(low, high, smoothstep(0, 28, elev))
    sources = window_sources(cloud)
    # (strength, colour, direction) of each light that is up
    lights = [(strength, ink, window_light(max(alt, 0.3), window_bearing(bearing, lat)))
              for strength, ink, alt, bearing in ((sun, sunlit, elev, az), (moon, moonlit, moon_alt, moon_az))
              if strength > 0.002]

    aspect = width / height
    gw, gh = max(48, width // WINDOW_SCALE), max(30, height // WINDOW_SCALE)
    # The indirect light is smooth, and so is worked out on a coarser grid:
    # the sky's through the panes, then what each light's patch gives back.
    cw, ch = max(16, gw // WINDOW_GLOW_SCALE), max(10, gh // WINDOW_GLOW_SCALE)
    lamp_sets = [window_lamps()] + [window_lamps(light) for _, _, light in lights]
    glows = [[] for _ in lamp_sets]
    for cy in range(ch):
        views = [window_view(((cx + 0.5) / cw - 0.5) * aspect, 0.5 - (cy + 0.5) / ch) for cx in range(cw)]
        for glow, lamps in zip(glows, lamp_sets):
            glow.append([window_glow(point, normal, lamps) for point, normal in views])

    def view_row(gy):
        return [window_view(((gx + 0.5) / gw - 0.5) * aspect, 0.5 - (gy + 0.5) / gh)
                for gx in range(gw + 1)]

    out = bytearray()
    below = view_row(0)
    for gy in range(gh):
        fy = (gy + 0.5) / gh
        views, below = below, view_row(gy + 1)
        for gx in range(gw):
            fx = (gx + 0.5) / gw
            point, normal = views[gx]
            sky = WINDOW_SKY * sample_grid(glows[0], fx, fy)
            lab = lerp(night, shade, ambient * (0.3 + 0.7 * sky / (1 + sky)))
            for (strength, ink, light), glow in zip(lights, glows[1:]):
                bounce = WINDOW_BOUNCE * strength * sample_grid(glow, fx, fy)
                lab = lerp(lab, ink, bounce / (1 + bounce))
                facing = normal[0] * light[0] + normal[1] * light[1] + normal[2] * light[2]
                trace = window_trace(point, light) if facing > 0 else None
                if trace:
                    # A cell of the picture takes in a stretch of the room, and
                    # so of the window, most where it looks along the floor.
                    beside = window_trace(views[gx + 1][0], light) or trace
                    under = window_trace(below[gx][0], light) or trace
                    grain = (abs(beside[0] - trace[0]) + abs(under[0] - trace[0]),
                             abs(beside[1] - trace[1]) + abs(under[1] - trace[1]))
                    direct = strength * window_cover(*trace, sources, grain)
                    if direct > 0:
                        lab = lerp(lab, ink, direct * facing ** WINDOW_GRAZE)
            out += struct.pack(">HHH", *(round(clamp(v) * 65535) for v in oklab_to_srgb(lab)))
    ppm_path = os.path.join(STATE_DIR, "window.ppm")
    with open(ppm_path, "wb") as f:
        f.write(f"P6\n{gw} {gh}\n65535\n".encode() + bytes(out))
    temporary = out_path + ".tmp.png"
    subprocess.run([which("magick"), ppm_path, "-resize", f"{width}x{height}!",
                    "-attenuate", "0.25", "+noise", "Gaussian", "-depth", "8", temporary],
                   check=True, timeout=60)
    os.replace(temporary, out_path)


def screen_size():
    if IS_MAC:
        try:
            out = subprocess.run(["system_profiler", "SPDisplaysDataType", "-json"],
                                 capture_output=True, text=True, timeout=30).stdout
            sizes = []
            for gpu in json.loads(out)["SPDisplaysDataType"]:
                for display in gpu.get("spdisplays_ndrvs", []):
                    m = re.match(r"(\d+)\s*x\s*(\d+)", display.get("_spdisplays_pixels", ""))
                    if m:
                        sizes.append((int(m.group(1)), int(m.group(2))))
            if sizes:
                return max(sizes, key=lambda s: s[0] * s[1])
        except Exception:
            pass
        return 2560, 1600
    try:
        out = subprocess.run([which("hyprctl"), "monitors", "-j"],
                             capture_output=True, text=True, timeout=10).stdout
        mons = json.loads(out)
        best = max(mons, key=lambda m: m["width"] * m["height"])
        w, h = best["width"], best["height"]
        if best.get("transform", 0) % 2 == 1:
            w, h = h, w
        return w, h
    except Exception:
        return 2560, 1600


def render_sky(out_path, width, height, t_utc, lat, lon, cloud, fog, colors):
    os.makedirs(STATE_DIR, exist_ok=True)
    elev, az = solar_position(lat, lon, t_utc)
    if current_style() == "daylight":
        render_daylight(out_path, width, height, t_utc, lat, lon)
        return elev, az
    if current_style() == "bokashi":
        render_bokashi(out_path, width, height, t_utc, lat, lon, colors)
        return elev, az
    if current_style() == "cyanotype":
        render_cyanotype(out_path, width, height, t_utc, lat, lon, colors)
        return elev, az
    if current_style() == "gradient":
        render_gradient(out_path, width, height, t_utc, lat, lon, colors)
        return elev, az
    if current_style() == "window":
        render_window(out_path, width, height, t_utc, lat, lon, cloud, fog, colors)
        return elev, az
    if current_style() == "slitscan":
        render_slitscan(out_path, width, height, t_utc, lat, lon, colors)
        return elev, az
    pixels = sky_field(colors, elev, az, cloud, fog)

    ppm_path = os.path.join(STATE_DIR, "field.ppm")
    with open(ppm_path, "wb") as f:
        f.write(f"P6\n{GRID_W} {GRID_H}\n65535\n".encode())
        for row in pixels:
            for color in row:
                f.write(struct.pack(">HHH", *(round(clamp(v) * 65535) for v in color)))

    cmd = [which("magick"), ppm_path, "-resize", f"{width}x{height}!"]
    milk = milky_way_ppm(width, height, elev, cloud, colors, t_utc, lat, lon)
    if milk:
        milk_path = os.path.join(STATE_DIR, "milkyway.ppm")
        with open(milk_path, "wb") as f:
            f.write(milk)
        cmd += ["(", milk_path, "-resize", f"{width}x{height}!", ")",
                "-compose", "Screen", "-composite"]
    cmd += ["-attenuate", "0.25", "+noise", "Gaussian", "-depth", "8"]
    mvg = star_mvg(width, height, elev, cloud, colors, t_utc, lat, lon)
    if mvg:
        mvg_path = os.path.join(STATE_DIR, "stars.mvg")
        with open(mvg_path, "w") as f:
            f.write(mvg)
        cmd += ["-draw", f"@{mvg_path}"]
    temporary = out_path + ".tmp.png"
    subprocess.run(cmd + [temporary], check=True, timeout=60)
    os.replace(temporary, out_path)
    return elev, az


def current_background():
    """Real path of the current background, or "" when unknown."""
    if IS_MAC:
        try:
            out = subprocess.run(
                [which("osascript"), "-e",
                 'tell application "System Events" to get picture of first desktop'],
                capture_output=True, text=True, timeout=15).stdout.strip()
            return os.path.realpath(out) if out else ""
        except Exception:
            return ""
    return os.path.realpath(BACKGROUND_LINK) if os.path.islink(BACKGROUND_LINK) else ""


def set_background(path):
    if IS_MAC:
        subprocess.run(
            [which("osascript"), "-e",
             f'tell application "System Events" to set picture of every desktop to "{path}"'],
            check=True, timeout=30)
    else:
        subprocess.run([which("omarchy"), "theme", "bg", "set", path], check=True, timeout=30)


def wallpaper_store_paths():
    """Real paths of every image the macOS wallpaper store records, for any
    Space or display, current or long gone. Each choice is a nested binary
    plist; an unreadable store records nothing."""
    found = set()

    def walk(value):
        if isinstance(value, dict):
            for item in value.values():
                walk(item)
        elif isinstance(value, list):
            for item in value:
                walk(item)
        elif isinstance(value, bytes) and value.startswith(b"bplist"):
            # A corrupt blob can fail in many ways; skip it and keep the rest.
            with contextlib.suppress(Exception):
                walk(plistlib.loads(value))
        elif isinstance(value, str) and value.startswith("file://"):
            found.add(os.path.realpath(urllib.parse.unquote(urllib.parse.urlparse(value).path)))

    try:
        with open(WALLPAPER_STORE, "rb") as f:
            store = plistlib.load(f)
    except Exception:
        return found
    walk(store)
    return found


def recent_renders(count=2):
    """The `count` most recently written renders, newest first."""
    paths = [os.path.join(STATE_DIR, name) for name in os.listdir(STATE_DIR)
             if RENDER_NAME.fullmatch(name)]
    return sorted(paths, key=os.path.getmtime, reverse=True)[:count]


def renders_in_use():
    """Real paths of renders that must not be overwritten yet: the current
    background (on macOS, the image each Space and display was last given)
    and the last two renders. The desktop may not have reached the latest
    yet, and macOS keeps the one before it loaded for a few seconds after it
    is replaced, bringing that image back if its path is set again meanwhile."""
    in_use = wallpaper_store_paths() if IS_MAC else {current_background()}
    in_use.update(os.path.realpath(path) for path in recent_renders())
    return in_use - {""}


def generate_and_set():
    with render_lock():
        lat, lon = get_location()
        cloud, fog = get_weather(lat, lon)
        width, height = screen_size()

        # Background watchers key on the path, so a render never reuses the
        # name of one that a desktop is showing: Quattro watches the symlink
        # target, and macOS's wallpaper agent reuses the image it decoded for
        # a path while any Space still shows that path. But the names come
        # from a small pool, sky-0.png upward: macOS remembers every image
        # file it is ever given and rechecks that whole list on every change,
        # so with a new name each tick, every change took longer until it
        # took half a minute.
        in_use = renders_in_use()
        out_path = next(path for path in (os.path.join(STATE_DIR, f"sky-{k}.png")
                                          for k in itertools.count())
                        if os.path.realpath(path) not in in_use)

        elev, az = render_sky(out_path, width, height,
                              datetime.datetime.now(datetime.timezone.utc),
                              lat, lon, cloud, fog, theme_colors())
        set_background(out_path)
        prune_renders(keep=in_use | {os.path.realpath(out_path)})
    return elev, cloud, fog


def prune_renders(keep):
    """Delete renders other than `keep`: the new one, and those a desktop may
    still show or be loading."""
    for name in os.listdir(STATE_DIR):
        path = os.path.join(STATE_DIR, name)
        if name.startswith("sky-") and name.endswith(".png") and os.path.realpath(path) not in keep:
            with contextlib.suppress(FileNotFoundError):
                os.remove(path)


def montage_font():
    """Homebrew ImageMagick ships without a default font; hand it a system one."""
    if not IS_MAC:
        return []
    for path in ("/System/Library/Fonts/Supplemental/Arial.ttf",
                 "/System/Library/Fonts/Helvetica.ttc",
                 "/System/Library/Fonts/SFNS.ttf"):
        if os.path.isfile(path):
            return ["-font", path]
    return []


def render_preview(cloud_override=None):
    lat, lon = get_location()
    if cloud_override is None:
        cloud, fog = get_weather(lat, lon)
    else:
        cloud, fog = clamp(cloud_override / 100), False
    colors = theme_colors()
    now_local = datetime.datetime.now().astimezone()
    panels = []
    for hour in range(24):
        local = now_local.replace(hour=hour, minute=0, second=0, microsecond=0)
        t_utc = local.astimezone(datetime.timezone.utc)
        panel = os.path.join(STATE_DIR, f"preview-{hour:02d}.png")
        elev, _ = render_sky(panel, 130, 300, t_utc, lat, lon, cloud, fog, colors)
        subprocess.run([which("magick"), panel, "-set", "label",
                        f"{hour:02d}:00  {elev:+.0f}°", panel], check=True)
        panels.append(panel)
    out = os.path.join(HOME, "Pictures/skybg-day-preview.png")
    temporary = out + ".tmp.png"
    os.makedirs(os.path.dirname(out), exist_ok=True)
    subprocess.run([which("montage")] + panels + montage_font() + [
        "-tile", "8x3", "-geometry", "+3+3", "-background", "#111",
        "-fill", "#ccc", "-pointsize", "13", temporary], check=True)
    os.replace(temporary, out)
    for panel in panels:
        os.remove(panel)
    return out, cloud


def owns_background():
    current = current_background()
    return bool(current) and current.startswith(os.path.realpath(STATE_DIR) + os.sep)


def gui_domain():
    return f"gui/{os.getuid()}"


def timer_active():
    if IS_MAC:
        return subprocess.run(
            ["launchctl", "print", f"{gui_domain()}/{LAUNCH_AGENT_LABEL}"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ).returncode == 0
    return subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", "skybg.timer"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0


def timer_enable():
    if IS_MAC:
        if not os.path.isfile(LAUNCH_AGENT_PLIST):
            raise SkybgError(f"{LAUNCH_AGENT_PLIST} is not installed; run ./install.sh")
        service = f"{gui_domain()}/{LAUNCH_AGENT_LABEL}"
        subprocess.run(["launchctl", "enable", service], check=True)
        subprocess.run(["launchctl", "bootout", service],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["launchctl", "bootstrap", gui_domain(), LAUNCH_AGENT_PLIST], check=True)
    else:
        subprocess.run(["systemctl", "--user", "enable", "--now", "skybg.timer"], check=True)


def timer_disable():
    if IS_MAC:
        # Disable before bootout: launch agents auto-load at login, and when
        # `skybg tick` disables its own agent, bootout terminates this process.
        service = f"{gui_domain()}/{LAUNCH_AGENT_LABEL}"
        subprocess.run(["launchctl", "disable", service])
        subprocess.run(["launchctl", "bootout", service],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.run(["systemctl", "--user", "disable", "--now", "skybg.timer"])


# ---------- commands ----------

def weather_words(cloud, fog):
    if current_style() not in WEATHER_STYLES:
        return f"{current_style()} style"
    if fog:
        return "fog"
    return f"{round(cloud * 100)}% cloud"


def configure(args):
    config = load_config()
    if args.config_command == "show":
        print(f"location: {config['location']}")
        print(f"weather: {'on' if config['weather'] else 'off'}")
        print(f"style: {config['style']}")
    elif args.config_command == "location":
        if args.latitude == "auto":
            if args.longitude is not None:
                raise SkybgError("'auto' does not take a longitude")
            config["location"] = "auto"
        else:
            try:
                lat, lon = float(args.latitude), float(args.longitude)
            except (TypeError, ValueError) as exc:
                raise SkybgError("location requires LAT LON, or 'auto'") from exc
            if not (-90 <= lat <= 90 and -180 <= lon <= 180):
                raise SkybgError("latitude must be -90..90 and longitude -180..180")
            config["location"] = [lat, lon]
        save_config(config)
        print(f"saved {CONFIG_FILE}")
    elif args.config_command == "weather":
        config["weather"] = args.value == "on"
        save_config(config)
        print(f"weather {'enabled' if config['weather'] else 'disabled'}")
    elif args.config_command == "style":
        config["style"] = args.value
        save_config(config)
        print(f"style set to {args.value}; run 'skybg once' to see it")


def agent_python():
    """(okay, detail) for the Python the launch agent runs skybg with. A plist
    that starts with skybg itself gets python3 from launchd's PATH, which
    finds only the system's Python 3.9."""
    try:
        with open(LAUNCH_AGENT_PLIST, "rb") as f:
            program = plistlib.load(f)["ProgramArguments"][0]
    except Exception as exc:
        return False, f"could not read {LAUNCH_AGENT_PLIST}: {exc}"
    python = program
    if os.path.basename(program) == "skybg":
        python = shutil.which("python3", path="/usr/bin:/bin:/usr/sbin:/sbin") or "python3"
    try:
        version = subprocess.run([python, "-c", "import sys; print(sys.version.split()[0])"],
                                 capture_output=True, text=True, timeout=10).stdout.strip()
        okay = tuple(int(part) for part in version.split(".")[:2]) >= (3, 11)
    except (OSError, subprocess.SubprocessError, ValueError):
        return False, f"{python} does not run; rerun ./install.sh"
    return okay, f"{python} {version}" + ("" if okay else " (needs 3.11+); rerun ./install.sh")


def doctor():
    checks = []
    advisory = set()
    commands = ("magick", "montage") if IS_MAC else ("omarchy", "magick", "montage", "systemctl")
    for command in commands:
        checks.append((command, which(command) != command, "required command"))
    if IS_MAC:
        okay = sys.version_info >= (3, 11)
        checks.append(("Python 3.11+", okay, f"running {sys.version.split()[0]}"))
        kind, detail = theme_source()
        sources = {"omarchy": f"Omarchy theme at {detail}",
                   "file": f"user palette at {detail}",
                   "builtin": f"built-in {detail} palette (system appearance)"}
        checks.append(("theme colors", True, sources[kind]))
        checks.append((LAUNCH_AGENT_LABEL, os.path.isfile(LAUNCH_AGENT_PLIST),
                       "installed launch agent"))
        if os.path.isfile(LAUNCH_AGENT_PLIST):
            checks.append(("launch agent Python", *agent_python()))
    else:
        checks.append(("Omarchy theme", os.path.isfile(COLORS_TOML), COLORS_TOML))
        checks.append(("Hyprland session", bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")),
                       "monitor size falls back to 2560x1600 when unavailable"))
        advisory.add("Hyprland session")
        unit_dir = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")),
                                "systemd/user")
        for unit in ("skybg.service", "skybg.timer"):
            checks.append((unit, os.path.isfile(os.path.join(unit_dir, unit)),
                           "installed user unit"))
    try:
        checks.append(("sky data", True, data_dir()))
    except SkybgError as exc:
        checks.append(("sky data", False, str(exc)))
    try:
        lat, lon = get_location()
        checks.append(("location", True, f"{lat:.4f}, {lon:.4f}"))
    except SkybgError as exc:
        checks.append(("location", False, str(exc)))
    for name, okay, detail in checks:
        print(f"{'ok' if okay else 'FAIL':4}  {name}: {detail}")
    return all(okay for name, okay, detail in checks if name not in advisory)


def parser():
    p = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0])
    commands = p.add_subparsers(dest="command")
    for name in ("on", "off", "once", "tick", "status", "doctor"):
        commands.add_parser(name)
    preview = commands.add_parser("preview")
    preview.add_argument("cloud", nargs="?", type=float, metavar="0..100")
    config = commands.add_parser("config")
    config_commands = config.add_subparsers(dest="config_command", required=True)
    config_commands.add_parser("show")
    location = config_commands.add_parser("location")
    location.add_argument("latitude", help="latitude, or 'auto'")
    location.add_argument("longitude", nargs="?")
    weather = config_commands.add_parser("weather")
    weather.add_argument("value", choices=("on", "off"))
    style = config_commands.add_parser("style")
    style.add_argument("value", choices=STYLES)
    return p


def run(args):
    cmd = args.command or "status"

    if cmd == "on":
        if os.path.exists(FOREIGN_MARKER):
            os.remove(FOREIGN_MARKER)
        elev, cloud, fog = generate_and_set()
        timer_enable()
        print(f"skybg on — sun at {elev:+.1f}° ({phase_name(elev)}), "
              f"{weather_words(cloud, fog)}, refreshing every 5 minutes")
    elif cmd == "off":
        if os.path.exists(FOREIGN_MARKER):
            os.remove(FOREIGN_MARKER)
        timer_disable()
        print("skybg off — background left as-is")
    elif cmd == "once":
        elev, cloud, fog = generate_and_set()
        print(f"skybg — sun at {elev:+.1f}° ({phase_name(elev)}), {weather_words(cloud, fog)}")
    elif cmd == "tick":
        if owns_background():
            if os.path.exists(FOREIGN_MARKER):
                os.remove(FOREIGN_MARKER)
            generate_and_set()
        elif os.path.exists(FOREIGN_MARKER):
            # Foreign background two ticks in a row: the user really did switch
            # away (e.g. cycled to a photo). Bow out gracefully.
            os.remove(FOREIGN_MARKER)
            timer_disable()
        else:
            # First foreign sighting may just be a theme-change transition
            # racing this tick (the theme-set hook re-owns shortly after).
            # Leave the background alone and decide next tick.
            open(FOREIGN_MARKER, "w").close()
    elif cmd == "preview":
        if args.cloud is not None and not 0 <= args.cloud <= 100:
            raise SkybgError("preview cloud cover must be between 0 and 100")
        with render_lock():
            out, cloud = render_preview(args.cloud)
        print(f"wrote {out} ({weather_words(cloud, False)})")
    elif cmd == "status":
        lat, lon = get_location()
        cloud, fog = get_weather(lat, lon)
        elev, az = solar_position(lat, lon, datetime.datetime.now(datetime.timezone.utc))
        stars = star_visibility(elev, max(cloud, 0.85) if fog else cloud) > 0
        style = current_style()
        print(f"location: {lat:.4f}, {lon:.4f}")
        print(f"sun: {elev:+.1f}° elevation, {az:.0f}° azimuth ({phase_name(elev)})")
        print(f"style: {style}")
        if style == "daylight":
            rise, fall = sun_times(lat, lon, datetime.datetime.now().astimezone())
            clock = lambda h: f"{int(h):02d}:{round(h % 1 * 60) % 60:02d}"
            print(f"sunrise {clock(rise)}, sunset {clock(fall)} — weather and theme not used")
        elif style in ("bokashi", "cyanotype"):
            alt, bearing, fraction, waxing = moon_position(
                lat, lon, datetime.datetime.now(datetime.timezone.utc))
            print(f"moon: {alt:+.1f}° elevation, {bearing:.0f}° azimuth, {round(fraction * 100)}% lit, "
                  f"{'waxing' if waxing else 'waning'} — weather not used")
        elif style in ("gradient", "slitscan"):
            print("weather not used")
        elif style == "window":
            alt, _, fraction, _ = moon_position(lat, lon, datetime.datetime.now(datetime.timezone.utc))
            print(f"weather: {weather_words(cloud, fog)} — moon {alt:+.1f}° elevation, "
                  f"{round(fraction * 100)}% lit")
        else:
            print(f"weather: {weather_words(cloud, fog)} — stars {'visible' if stars else 'hidden'}")
        print(f"timer: {'active' if timer_active() else 'inactive'}")
        print(f"background owned by skybg: {'yes' if owns_background() else 'no'}")
    elif cmd == "doctor":
        return 0 if doctor() else 1
    elif cmd == "config":
        configure(args)
    return 0


def main():
    args = parser().parse_args()
    try:
        return run(args)
    except SkybgError as exc:
        print(f"skybg: {exc}", file=sys.stderr)
        return 2
    except FileNotFoundError as exc:
        print(f"skybg: required command not found: {exc.filename}", file=sys.stderr)
        return 2
    except subprocess.CalledProcessError as exc:
        print(f"skybg: command failed ({exc.returncode}): {' '.join(exc.cmd)}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
